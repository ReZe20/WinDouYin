<?xml version="1.0" encoding="utf-8"?>
<!--
  VS 发布档案：Native AOT 打包（x64，默认：.NET 自包含 + WASDK 框架依赖）。
  ⚠ 首选正式包；目标机只需要 Windows App Runtime 2.5（Store 自动更新或运行时安装器），不需要 .NET。

  用法：解决方案配置切到 Release → 右键项目「发布」，或在项目属性「发布」页选本档案后点发布。
  产出：WinDouYin\bin\Package\win-x64\，约 27MB / 11 文件，WinDouYin.exe 14.8MB，非打包（直接双击运行）。
  命令行等价：dotnet publish WinDouYin/WinDouYin.csproj -p:Platform=x64 -p:PublishProfile=win-x64

  AOT 优化档走工程默认 OptimizationPreference=Size；要对照 Speed 加 -p:OptimizationPreference=Speed。
  WASDK 那层默认框架依赖（WindowsAppSDKSelfContained=false）：包里只带 Bootstrap.dll，
  启动时激活系统 Windows App Runtime 2.5。要免装运行时：改用 win-x64-selfcontained.pubxml
  （.NET AOT + 修剪版 WASDK，约 74MB / 40 文件）。

  ⚠ 别在 csproj 里写 <PublishProfile>win-x64.pubxml</PublishProfile>（模板默认的
     win-$(Platform).pubxml 那行已删）。那样 SDK 每次求值——普通 Build / F5 也算——都会
     导入本档案，下面钉的 DebugType=none 会漏进调试，Debug 不再出 pdb。档案只该由发布动作
     或 -p:PublishProfile=<名> 显式选中。

  口径与踩过的坑都记在 HANDOVER.md：§2（AOT 通道三条硬规矩）、§11.5（包里摘掉了什么、pdb 为什么默认不进包）。
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <!-- 钉死 Release：档案晚于工程主体导入，这里设的值对整个发布过程有效。
         注意工具栏若停在 Debug，VS 会把 Configuration 当全局属性传进来压住这一行——发布前切到 Release。 -->
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>x64</LastUsedPlatform>

    <!-- AOT 已是工程默认值（csproj 里带 PublishAot 默认 true，restore 阶段就得看见）。
         这里再显式写一遍，是为了让本档案被单独传给命令行时也走得通。 -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- 本档案只用于出 AOT 包：csproj 的 AssertNativeAotPublish 在 PublishAot!=true 时直接报错 -->
    <RequireNativeAot>true</RequireNativeAot>
    <!-- 默认档：WASDK 框架依赖，包里不带 WinUI/WASDK 原生负载 -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>

    <!-- 每次发布先清空目标目录：踩过"上一轮遗留的 85.8MB pdb 被 _CopyAotSymbols 搬进新包"，
         Copy 会保留源时间戳，光看文件新旧根本发现不了。这条从源头挡住。 -->
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <PublishDir>bin\Package\win-x64\</PublishDir>
    <publishUrl>bin\Package\win-x64\</publishUrl>

    <!-- 包里不放原生 pdb（单文件 85.8MB，占整包三分之一）。
         托管栈的方法名不靠它——由 IlcGenerateStackTraceData 提供，实测无 pdb 时 exception.log
         仍打 "at 方法名 + 0x偏移"。要 WinDbg 对源码行就改用 win-x64-symbols.pubxml。 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
</Project>
