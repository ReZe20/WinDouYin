<?xml version="1.0" encoding="utf-8"?>
<!--
  VS 发布档案：Native AOT 打包（x86，WASDK 框架依赖）。
  ⚠ 未实测：x64 那条已跑通（HANDOVER §11），这份只是把同一套口径对齐到 x86。
     目标机需要 Windows App Runtime 2.5（x86 版），不需要 .NET；要免装运行时就显式设
     WindowsAppSDKSelfContained=true（包会带修剪后的 WASDK 原生负载，体积约翻倍）。
     本机是 x64 系统，x86 包能出但没在 32 位环境验过起播与 WebView2；要用前自己过一遍。
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>x86</Platform>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>x86</LastUsedPlatform>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- 默认档：WASDK 框架依赖；真自包含改成 true 并接受 WASDK 原生负载 -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- 本档案只用于出 AOT 包：csproj 的 AssertNativeAotPublish 在 PublishAot!=true 时直接报错 -->
    <RequireNativeAot>true</RequireNativeAot>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <PublishDir>bin\Release\net10.0-windows10.0.19041.0\win-x86\publish\</PublishDir>
    <publishUrl>bin\Release\net10.0-windows10.0.19041.0\win-x86\publish\</publishUrl>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
</Project>
