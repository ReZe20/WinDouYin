<?xml version="1.0" encoding="utf-8"?>
<!--
  VS 发布档案：Native AOT 打包（x64，带原生 pdb，WASDK 框架依赖）。
  与 win-x64.pubxml 只差符号那三项；WASDK 仍框架依赖（调试机已装 Windows App Runtime 2.5）。
  产出约 27MB + 一个约 77MB 的 WinDouYin.pdb（合计约 104MB），只用于 WinDbg 把地址对到源码行，
  别拿它当正式包分发。
  命令行等价：dotnet publish WinDouYin/WinDouYin.csproj -p:Platform=x64 -p:PublishProfile=win-x64-symbols
  同样别把本档案钉进 csproj 的 <PublishProfile>：那会让普通 Build 也导入档案属性。
  详见 win-x64.pubxml 头部说明与 HANDOVER.md 第四十六轮。
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>x64</LastUsedPlatform>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- 本档案只用于出 AOT 包：csproj 的 AssertNativeAotPublish 在 PublishAot!=true 时直接报错 -->
    <RequireNativeAot>true</RequireNativeAot>
    <!-- 与默认档一致：WASDK 框架依赖 -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <!-- 单独一个目录：别让带符号的包把正式包目录盖掉（正式包靠 DeleteExistingFiles 清目录） -->
    <PublishDir>bin\Package\win-x64-symbols\</PublishDir>
    <publishUrl>bin\Package\win-x64-symbols\</publishUrl>
    <!-- 这一份就是差异所在：出 portable 原生符号，并让它进发布目录 -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>true</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
</Project>
