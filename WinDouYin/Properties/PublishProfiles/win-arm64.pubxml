<?xml version="1.0" encoding="utf-8"?>
<!--
  VS 发布档案：Native AOT 打包（ARM64，WASDK 框架依赖）。
  ⚠ 未实测：x64 那条已跑通（HANDOVER §11），这份只是把同一套口径对齐到 ARM64。
     AOT 链接需要 VS 装上 VC++ 的 ARM64 工具集（"C++ ARM64 生成工具"组件），缺了会在 LinkNative 阶段报错。
     目标机需要 Windows App Runtime 2.5（ARM64 版），不需要 .NET；要免装运行时就显式设
     WindowsAppSDKSelfContained=true（包会带修剪后的 WASDK 原生负载，体积约翻倍）。
     要用之前先在 ARM64 设备上过一次启动 + 播放 + 登录窗。
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>ARM64</Platform>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>ARM64</LastUsedPlatform>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- 默认档：WASDK 框架依赖；真自包含改成 true 并接受 WASDK 原生负载 -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- 本档案只用于出 AOT 包：csproj 的 AssertNativeAotPublish 在 PublishAot!=true 时直接报错 -->
    <RequireNativeAot>true</RequireNativeAot>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <PublishDir>bin\Release\net10.0-windows10.0.19041.0\win-arm64\publish\</PublishDir>
    <publishUrl>bin\Release\net10.0-windows10.0.19041.0\win-arm64\publish\</publishUrl>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
</Project>
