<?xml version="1.0" encoding="utf-8"?>
<!--
  VS 发布档案：Native AOT 打包（x64，真自包含：.NET AOT + 修剪版 WASDK）。
  用法：解决方案配置切到 Release + 平台 x64 → 右键项目「发布」→ 选本档案。
  命令行等价：dotnet publish WinDouYin/WinDouYin.csproj -p:Platform=x64 -p:PublishProfile=win-x64-selfcontained
  产出：WinDouYin\bin\Package\win-x64-selfcontained\，约 74MB / 40 文件，双击 WinDouYin.exe 直接运行。
  AOT 优化档走工程默认 OptimizationPreference=Size；要对照 Speed 加 -p:OptimizationPreference=Speed。

  与 win-x64.pubxml（框架依赖档）的差别只有 WASDK 那层：
    · 本档案 WindowsAppSDKSelfContained=true，把 WASDK Framework 包的原生负载放进输出目录；
    · .NET 仍是 Native AOT 自包含（SelfContained=true），目标机不需要 .NET 运行时；
    · 目标机也不需要安装 Windows App Runtime 2.5；框架依赖档才需要。
  修剪由 csproj 的 TrimUnshippedPayload 在发布清单上做：AI/ML/Search/Widgets、Designer、DwmSceneI、
  Workloads、NPUDetect、Graphics.Display、RestartAgent、38 个 .winmd、非 zh-CN/en-us 的 .mui 都会摘掉。
  第五十三轮又按模块加载清单摘掉自包含档专属的 DWriteCore/wuceffectsi/Bootstrap 与 workloads 数据文件
  （启动+播放+弹幕链路未加载；截图确认文字渲染正常）；19h1/common 资源 DLL 保留给 Win10 19041。
  逐项启动实测过：WinUIEdit.dll（TextBox 创建）与 Microsoft.UI.Xaml.Phone.dll（首帧后不卡死）必须留。

  档案是在 VS 模板生成的档案上改的：
    1. 删掉模板的 <PublishTrimmed>false</PublishTrimmed>——AOT 下裁剪由 ILCompiler 隐含，显式关掉会在
       _ComputeAssembliesToCompileToNative 报 "cannot be disabled"；
    2. 补 AOT 与符号口径（PublishAot / DebugType / CopyOutputSymbolsToPublishDirectory）。
  要带原生 pdb 调试符号：改用 win-x64-symbols.pubxml（框架依赖口径）。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishDir>bin\Package\win-x64-selfcontained</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- 本档案只用于出 AOT 包：csproj 的 AssertNativeAotPublish 在 PublishAot!=true 时直接报错 -->
    <RequireNativeAot>true</RequireNativeAot>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- 真自包含的关键：把修剪后的 WASDK 原生负载随包带上 -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- AOT 已是工程默认值；这里显式写一遍，表明本档案就是 AOT 通道 -->
    <PublishAot>true</PublishAot>
    <!-- 每次发布先清空目标目录：挡住"上轮遗留 pdb 被 _CopyAotSymbols 搬进新包"那个坑 -->
    <DeleteExistingFiles>true</DeleteExistingFiles>

    <!-- 正式包不带原生 pdb（单文件约 77MB）。托管栈方法名由 IlcGenerateStackTraceData 供，
         实测无 pdb 时 exception.log 仍打 "at 方法名 + 0x偏移" -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <IlcGenerateStackTraceData>true</IlcGenerateStackTraceData>
  </PropertyGroup>
</Project>
