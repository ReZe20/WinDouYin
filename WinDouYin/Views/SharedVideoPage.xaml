<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinDouYin.Views.SharedVideoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinDouYin.Views"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    NavigationCacheMode="Required">

    <!-- 从聊天分享卡打开的视频详情：直接在主窗口 ContentFrame 里导航，不另开窗口。
         舞台直接用标准 VideoPage（与推荐页同一套），本页只管上下文与来源评论。
         页面缓存：离场 Suspend 释放两页播放源，回场 Bind 后 Resume 重装（见代码）。 -->
    <Grid>
        <!-- 场上一页在放，幕外一页候场下一条；换台按方向对滑 250ms，不用等新页重新起播。 -->
        <Grid x:Name="Host"
              Background="Black">
            <Grid.Clip>
                <RectangleGeometry x:Name="HostClip" />
            </Grid.Clip>

            <views:VideoPage x:Name="StageA">
                <views:VideoPage.RenderTransform>
                    <TranslateTransform />
                </views:VideoPage.RenderTransform>
            </views:VideoPage>

            <views:VideoPage x:Name="StageB">
                <views:VideoPage.RenderTransform>
                    <TranslateTransform />
                </views:VideoPage.RenderTransform>
            </views:VideoPage>
        </Grid>

        <!-- 下架/不存在占位：盖在舞台上，黑底大字。评论区还能看（评论接口与视频是否下架无关）。 -->
        <Border Background="Black"
                Visibility="{x:Bind IsTakenDown, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <FontIcon Glyph="&#xE8F2;"
                          FontSize="44"
                          Foreground="#80FFFFFF" />
                <TextBlock FontSize="18"
                           TextAlignment="Center"
                           Foreground="White"
                           Text="视频已下架或不存在" />
                <TextBlock FontSize="13"
                           Opacity="0.7"
                           TextAlignment="Center"
                           Foreground="White"
                           Text="{x:Bind Args.Video.Author, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!-- 返回键不再浮在画面上：归左栏那颗 NavigationView 原生 BackButton -->
    </Grid>
</Page>
