<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinDouYin.Views.FollowingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:WinDouYin.Controls"
    xmlns:vm="using:WinDouYin.ViewModels"
    xmlns:views="using:WinDouYin.Views"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Unloaded="OnPageUnloaded">

    <!--
        关注页（官方 douyin.com/follow，2026-10-21 实抓口径）：
        左栏 208px「列表」= 正在直播 + 我的关注（搜索 / 综合排序 / 最近关注 / 最早关注），
        右侧是全屏竖向视频舞台，右缘留 68px 给上下两条箭头（官方 1600 视口实测：视频 1164 + 右缝 68）。
        舞台复用标准 VideoPage（视频 + 信息区 + 右排 + 控制条都在 MfStageControl 里），
        两页轮流上场、幕外预热，和推荐页同一条换台路数。
    -->
    <Page.Resources>
        <Style x:Key="FollowIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="FollowSortButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="FollowRowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="StageArrowStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <DataTemplate x:Key="FollowSectionTemplate" x:DataType="vm:FollowSectionRow">
            <Grid Height="32"
                  Padding="12,5,10,8"
                  AutomationProperties.Name="{x:Bind Header}">
                <TextBlock Text="{x:Bind Header}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <!-- 收起后的头像条：官方是 72px 一格，直播在前（红圈），普通关注在后。 -->
        <DataTemplate x:Key="FollowRailTemplate" x:DataType="vm:FollowUserRow">
            <Grid Height="48"
                  AutomationProperties.Name="{x:Bind Nickname}"
                  ToolTipService.ToolTip="{x:Bind Nickname}">
                <Grid Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <PersonPicture Width="32"
                                   Height="32"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   ProfilePicture="{x:Bind Avatar}"
                                   Initials="{x:Bind Initials}" />
                    <Ellipse Stroke="#FF2D55"
                             StrokeThickness="1.5"
                             Visibility="{x:Bind RingVisibility}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FollowRowTemplate" x:DataType="vm:FollowUserRow">
            <Grid Height="48"
                  Padding="12,0"
                  ColumnSpacing="10"
                  AutomationProperties.Name="{x:Bind Nickname}"
                  ToolTipService.ToolTip="{x:Bind StatusText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="36" Height="36" VerticalAlignment="Center">
                    <PersonPicture Width="32"
                                   Height="32"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   ProfilePicture="{x:Bind Avatar}"
                                   Initials="{x:Bind Initials}" />
                    <Ellipse Stroke="#FF2D55"
                             StrokeThickness="1.5"
                             Visibility="{x:Bind RingVisibility}" />
                </Grid>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="1">
                    <TextBlock Text="{x:Bind Nickname}"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                    <TextBlock Text="{x:Bind StatusText}"
                               FontSize="11"
                               Foreground="#FFFF5C7A"
                               Visibility="{x:Bind StatusVisibility}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                </StackPanel>

                <Border Grid.Column="2"
                        Background="#33FF2D55"
                        CornerRadius="4"
                        Padding="5,1"
                        MinWidth="38"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind BadgeVisibility}">
                    <TextBlock Text="直播中"
                               FontSize="10"
                               TextWrapping="NoWrap"
                               HorizontalAlignment="Center"
                               Foreground="#FFFF5C7A" />
                </Border>
            </Grid>
        </DataTemplate>

        <controls:FollowItemTemplateSelector x:Key="FollowItemSelector"
                                             SectionTemplate="{StaticResource FollowSectionTemplate}"
                                             RowTemplate="{StaticResource FollowRowTemplate}" />
    </Page.Resources>

    <Grid x:Name="Root" Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左栏：列表。收起后换成 48px 窄条，舞台顺势铺开。 -->
        <Border x:Name="Sidebar"
                Grid.Column="0"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="48" Padding="12,0,10,0" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource FollowIconButtonStyle}"
                            Click="OnCollapseClick"
                            AutomationProperties.Name="收起列表"
                            ToolTipService.ToolTip="收起列表">
                        <FontIcon Glyph="&#xE76B;" FontSize="14" />
                    </Button>

                    <TextBlock Grid.Column="1"
                               Text="列表"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="2"
                            Style="{StaticResource FollowSortButtonStyle}"
                            AutomationProperties.Name="排序"
                            ToolTipService.ToolTip="排序">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.SortLabel, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <FontIcon Glyph="&#xE8CB;"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout>
                                <RadioMenuFlyoutItem x:Name="SortCompositeItem"
                                                     Text="综合排序"
                                                     GroupName="FollowSort"
                                                     IsChecked="True"
                                                     Click="OnSortCompositeClick" />
                                <RadioMenuFlyoutItem x:Name="SortRecentItem"
                                                     Text="最近关注"
                                                     GroupName="FollowSort"
                                                     Click="OnSortRecentClick" />
                                <RadioMenuFlyoutItem x:Name="SortEarliestItem"
                                                     Text="最早关注"
                                                     GroupName="FollowSort"
                                                     Click="OnSortEarliestClick" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <AutoSuggestBox x:Name="FollowSearch"
                                Grid.Row="1"
                                Height="36"
                                Margin="12,0,12,8"
                                QueryIcon="Find"
                                PlaceholderText="搜索用户或抖音号"
                                TextChanged="OnFollowSearchTextChanged" />

                <Grid Grid.Row="2">
                    <ListView x:Name="UserList"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="OnUserItemClick"
                              ItemContainerStyle="{StaticResource FollowRowStyle}"
                              ItemTemplateSelector="{StaticResource FollowItemSelector}"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden" />

                    <ProgressRing Width="18"
                                  Height="18"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,0,12"
                                  IsActive="True"
                                  Visibility="{x:Bind ViewModel.ListLoadingVisibility, Mode=OneWay}" />

                    <TextBlock Text="{x:Bind ViewModel.ListStatus, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.ListStatusVisibility, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               MaxWidth="180"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Border>

        <!-- 收起后的 72px 头像条：展开键 + 搜索键 + 一列头像，舞台占回宽度。 -->
        <Border x:Name="CollapsedRail"
                Grid.Column="0"
                Visibility="Collapsed"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Style="{StaticResource FollowIconButtonStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="OnExpandClick"
                        AutomationProperties.Name="展开列表"
                        ToolTipService.ToolTip="展开列表">
                    <FontIcon Glyph="&#xE700;" FontSize="14" />
                </Button>

                <Button Grid.Row="1"
                        Style="{StaticResource FollowIconButtonStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="OnRailSearchClick"
                        AutomationProperties.Name="搜索关注"
                        ToolTipService.ToolTip="搜索">
                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                </Button>

                <ListView x:Name="RailList"
                          Grid.Row="2"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnUserItemClick"
                          ItemContainerStyle="{StaticResource FollowRowStyle}"
                          ItemTemplate="{StaticResource FollowRailTemplate}"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="68" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="Host" Grid.Column="0" Background="Black">
                <Grid.Clip>
                    <RectangleGeometry x:Name="HostClip" Rect="0,0,0,0" />
                </Grid.Clip>

                <views:VideoPage x:Name="PageA">
                    <views:VideoPage.RenderTransform>
                        <TranslateTransform />
                    </views:VideoPage.RenderTransform>
                </views:VideoPage>

                <views:VideoPage x:Name="PageB">
                    <views:VideoPage.RenderTransform>
                        <TranslateTransform />
                    </views:VideoPage.RenderTransform>
                </views:VideoPage>

                <ProgressRing Width="44"
                              Height="44"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsActive="True"
                              Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}" />

                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           MaxWidth="420"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsHitTestVisible="False" />
            </Grid>

            <!-- 官方右缘那两条箭头：视频区之外，不压右侧动作列 -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8">
                <Button Style="{StaticResource StageArrowStyle}"
                        Click="OnPreviousClick"
                        AutomationProperties.Name="上一条"
                        ToolTipService.ToolTip="上一条">
                    <FontIcon Glyph="&#xE70E;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource StageArrowStyle}"
                        Click="OnNextClick"
                        AutomationProperties.Name="下一条"
                        ToolTipService.ToolTip="下一条">
                    <FontIcon Glyph="&#xE70D;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
