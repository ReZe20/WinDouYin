<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinDouYin.Views.FriendsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:WinDouYin.Views"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Unloaded="OnPageUnloaded">

    <!--
        朋友页（官方 douyin.com/friend，2026-10-21 实抓口径）：
        没有左栏，整页就是一条竖向视频舞台（视频 1372×885、底部 48 控制条），
        右缘 68px 留给上下两条箭头；弹幕/作者信息/动作列/控制条都在标准 VideoPage 里。
        换台沿用推荐页那套：两页常驻、幕外预热、按滚轮方向对滑 250ms。
    -->
    <Page.Resources>
        <Style x:Key="StageArrowStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="68" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="Host" Grid.Column="0" Background="Black">
            <Grid.Clip>
                <RectangleGeometry x:Name="HostClip" Rect="0,0,0,0" />
            </Grid.Clip>

            <views:VideoPage x:Name="PageA">
                <views:VideoPage.RenderTransform>
                    <TranslateTransform />
                </views:VideoPage.RenderTransform>
            </views:VideoPage>

            <views:VideoPage x:Name="PageB">
                <views:VideoPage.RenderTransform>
                    <TranslateTransform />
                </views:VideoPage.RenderTransform>
            </views:VideoPage>

            <ProgressRing Width="44"
                          Height="44"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsActive="True"
                          Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}" />

            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       MaxWidth="420"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsHitTestVisible="False" />
        </Grid>

        <!-- 官方右缘那两条箭头：视频区之外，不压右侧动作列 -->
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8">
            <Button Style="{StaticResource StageArrowStyle}"
                    Click="OnPreviousClick"
                    AutomationProperties.Name="上一条"
                    ToolTipService.ToolTip="上一条">
                <FontIcon Glyph="&#xE70E;" FontSize="14" />
            </Button>
            <Button Style="{StaticResource StageArrowStyle}"
                    Click="OnNextClick"
                    AutomationProperties.Name="下一条"
                    ToolTipService.ToolTip="下一条">
                <FontIcon Glyph="&#xE70D;" FontSize="14" />
            </Button>
        </StackPanel>
    </Grid>
</Page>
