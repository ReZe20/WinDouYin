<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinDouYin.Views.ForYouPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:WinDouYin.Views"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <!-- 一条视频一个页面：两页常驻、轮流上场。场上一页在放，幕外一页候场预热下一条，
         换台就是把两页按滚轮方向对滑 250ms（和官方那套一致），所以不用 Frame 导航——
         页面切换自带的 SlideNavigationTransitionInfo 没有"从上往下"那一档，也没法做候场。 -->
    <Grid x:Name="Host" Background="Black">
        <Grid.Clip>
            <RectangleGeometry x:Name="HostClip" />
        </Grid.Clip>

        <views:VideoPage x:Name="PageA">
            <views:VideoPage.RenderTransform>
                <TranslateTransform />
            </views:VideoPage.RenderTransform>
        </views:VideoPage>

        <views:VideoPage x:Name="PageB">
            <views:VideoPage.RenderTransform>
                <TranslateTransform />
            </views:VideoPage.RenderTransform>
        </views:VideoPage>
    </Grid>
</Page>
