<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinDouYin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinDouYin"
    xmlns:controls="using:WinDouYin.Controls"
    xmlns:ui="using:Microsoft.UI.Xaml"
    xmlns:vm="using:WinDouYin.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WinDouYin">

    <Grid x:Name="RootLayout">
        <!-- 顶栏搜索建议的口径都放这一层：原生下拉（AutoSuggestBox.ItemTemplate）和自绘弹层都在它的子树里，
             静态资源按解析树往上找才够得着。行度量照系统列表项（generic.xaml 实测：MinHeight 40、Padding 16,0,12,0）。 -->
        <Grid.Resources>
            <!-- 自绘面板的行：钮外 4 让圆角矩形缩进、钮内 12 把文字推到 16；底色走 SubtleButtonStyle 轻量档。
                 原生那面不能再套这颗钮——列表项自己吃点击，套了会两份动作。 -->
            <Style x:Key="SuggestRowStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>
            <!-- 段标题：WinUI 组头口径（12 半粗、次要色），左边 16 = 行的 4+12，与行文字齐平 -->
            <Style x:Key="SuggestHeaderStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- 搜索历史的胶囊：面/描边/圆角全取系统填充档（同 CheckBox 那颗的底），不自己调色。
                 宽度仍由内容决定（LinedFlowLayout 逐条排），但**封顶一行一半**：386 能摆胶囊 − 一颗间距 8
                 再对折＝189，取 188 → 一行稳稳两颗，长词自己省略号，不会把同排那颗挤下去。 -->
            <Style x:Key="SuggestChipStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="MaxWidth" Value="188" />
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>
            <!-- 名次 | 放大镜 | 词 | 热度。两份模板内容一致、只差外层那颗钮（原生面靠列表项吃点击），
                 改一处记得改另一处。两头那两列都**空了就整列收掉**：MinWidth 挂在子元素上、不挂在列上，
                 否则没名次/没热度的行左边白占 18+12、右边白占 72+12，词没到右沿就提前折行；
                 名次与放大镜同列互斥出现，列宽仍恒等 18，行与行不会错开。词一律单行，长了省略号。 -->
            <DataTemplate x:Key="SuggestNativeRowTemplate" x:DataType="vm:SearchSuggestion">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{x:Bind RankText}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               MinWidth="18"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Visibility="{x:Bind RankVisibility}" />
                    <FontIcon Glyph="&#xE721;"
                              FontSize="12"
                              MinWidth="18"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              Visibility="{x:Bind QueryIconVisibility}" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind Word}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               VerticalAlignment="Center"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               Text="{x:Bind HotText}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               MinWidth="72"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Visibility="{x:Bind HotVisibility}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="SuggestWordRowTemplate" x:DataType="vm:SearchSuggestion">
                <Button Style="{StaticResource SuggestRowStyle}"
                        Tag="{x:Bind Word}"
                        Click="OnSuggestRowClick">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{x:Bind RankText}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   MinWidth="18"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Visibility="{x:Bind RankVisibility}" />
                        <FontIcon Glyph="&#xE721;"
                                  FontSize="12"
                                  MinWidth="18"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  Visibility="{x:Bind QueryIconVisibility}" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Word}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind HotText}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   MinWidth="72"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Visibility="{x:Bind HotVisibility}" />
                    </Grid>
                </Button>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏换成系统自带的 TitleBar 控件（本包 generic.xaml:23042 起 DefaultTitleBarStyle 实测在），
             但要**关掉 AutoRefreshDragRegions**：命中区这本账不能交回它自管。
             开着自管时，控件在布局那一拍遍历自己那棵树去算矩形，实测在我们这棵顶栏树上读空指针——
             0xC0000005 读取 0x0，栈顶与循环体整屏是同一组框架地址（Microsoft.ui.xaml.dll 偏移 …bbe614d 起）；
             我们主动调 RecomputeDragRegions() 是它，删掉调用、只留自管也是它（2026-10-21 三轮 F5），
             连"返回键那颗 x:DeferLoadStrategy=Lazy 的 PART_BackButton 永不进树"也排除了。
             所以退回手挖那套：搜索框与账号格各自的矩形由 MainWindow.SetRegionsForCustomTitleBar 记，
             少挖一个就看得见点不动——加可点控件记得同时补一笔账。
             返回键就是模板里那颗 PART_BackButton：AnimatedIcon 版 E72B、宽 TitleBarBackButtonWidth=40、
             悬停/按下/禁用态全归系统，不自己画；它要不要进场由 MainWindow.TitleBarBackButtonEnabled 管
             （诊断期先收着，见那边注释），NavigationView 栏顶那颗继续永久收着，免得两头各一颗。 -->
        <TitleBar x:Name="AppTitleBar"
                  Height="48"
                  AutoRefreshDragRegions="False"
                  IsBackButtonVisible="False"
                  IsPaneToggleButtonVisible="False"
                  BackRequested="OnTitleBarBackRequested">
            <TitleBar.Resources>
                <!-- 模板根写死 Height={ThemeResource TitleBarCompactHeight}，本包实测那条量尺是 32；
                     而顶栏按官方 Tall 档（AppWindow.TitleBar.PreferredHeightOption）是 48。
                     覆盖这一条系统量尺就能落到 48，模板本体一行不动。 -->
                <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                <!-- Content 那个 ContentPresenter 默认 Center：只按内容想要的宽度排版、拉不满中间那一列。
                     改 Stretch 让它先把可用宽交下来，下面那层星号列的收缩合同才有得算。 -->
                <ui:HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</ui:HorizontalAlignment>
            </TitleBar.Resources>

            <TitleBar.Content>
                <!-- 合同是"左垫（星号列封顶 200）+ 1:1:3:1"，窗口变宽框跟着拉、变窄先缩垫子再谈框
                     （下面那格注释记了左垫的来路和为什么不能写死）。
                     最早这版是三列等分星号，中间永远只拿可用宽的 1/3——窗口 1200 那档框就停在 330 左右，
                     看着像被头像压短了，其实是两侧那两列空星号各分走一份；头像真正的账是右边多让了一笔（见 RightHeader 那条）。
                     这层 Grid 不是多余的：ContentPresenter 在模板里是
                     **Center** 对齐（只按内容想要的宽度排版），`*` 列的可用宽根本传不到框上——上一版把
                     MinWidth/MaxWidth 直接挂到框自己身上，它就停在 MinWidth，看着像没 stretch。
                     星号列自己的 DesiredWidth 就是"占满可用宽"，所以这层 Grid 无论 presenter 是 Center
                     还是 Stretch 都铺得开，宽度合同由列说话、代码里不算宽高。
                     分工也照官方、照 WinUI 自己的口径：
                     · 一输词 → 交回 AutoSuggestBox **原生自带**的那个下拉（它就是为"边打字边出建议"造的，
                       焦点、翻页、回车都不用我们操心）；模板换成 x:Bind 的三列 Grid，所以不再是空行。
                     · 还没输（清空/刚聚焦）→ 自绘的三段弹层摆 搜索历史 / 猜你想搜 / 抖音热点。
                     自绘弹层必须 ShowMode=Transient：FlyoutShowMode.Standard 的官方原文是
                     "The open flyout takes focus"——一开就把焦点从输入框抢走，打字就被打断（踩过两次）。 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- 第一格是"左垫"：右边被头像 34 + 模板最小拖动列 48 + 系统按钮区 138 吃掉一大截（实测随窗口宽窄在
                             175~220 DIP 之间浮），模板左边只占 2。不抵平，中间这格就是"剩余区的中心"而不是"窗口的中心"，
                             框看着偏左一截——微软商店实测框的中心正好压在窗口中线上。
                             但这一格**必须能缩**：写成固定 218 时，527 DIP 的窄窗里 218+右边 219 已经把可用宽吃光，
                             搜索框被挤成一条裁掉的缝。所以它是星号列 + MaxWidth，宽窗抵到 200 就停，窄窗跟着一起缩；
                             框那格另设 MinWidth=160 兜住，缩也是先缩垫子。两侧 1 份只留呼吸位，框拿 3 份。 -->
                        <ColumnDefinition Width="*"
                                          MaxWidth="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="3*"
                                          MinWidth="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox x:Name="TitleBarSearchBox"
                                    x:Uid="SearchBox"
                                    Grid.Column="2"
                                    Margin="0,0,0,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    ItemTemplate="{StaticResource SuggestNativeRowTemplate}"
                                    QueryIcon="Find">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="SuggestFlyout"
                                    Placement="Bottom"
                                    ShowMode="Transient"
                                    AllowFocusOnInteraction="False"
                                    ShouldConstrainToRootBounds="True">
                                <!-- 宽度写死 422，不是随手定的：FlyoutPresenter 的模板把内容塞进它**自己那个** ScrollViewer
                                     （generic.xaml 实测：Horizontal{ScrollMode,ScrollBarVisibility} 都是 Auto），而 presenter
                                     自身 MaxWidth=FlyoutThemeMaxWidth 456、内容 Margin=FlyoutContentPadding 左右各 16、描边各 1
                                     → 能用宽只有 422，这就是这一档弹层的物理上限。以前这里写 MinWidth 绑搜索框 ActualWidth +
                                     MaxWidth 520，比 422 宽出 98，于是弹层底部横着出一条横向滚动条（搜索框最宽能到 504，
                                     MinWidth>MaxWidth 时 MinWidth 说话，宽窗下必然顶破，所以干脆不绑）。 -->
                                <Grid Width="422">
                                    <ScrollViewer x:Name="SuggestPanel"
                                                  MaxHeight="460"
                                                  Padding="0,0,12,4"
                                                  HorizontalScrollMode="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  AutomationProperties.Name="搜索建议">
                                        <StackPanel>

                                            <!-- ── 空输入：搜索历史 / 猜你想搜 / 抖音热点，哪段没货哪段不摆 ── -->
                                            <StackPanel x:Name="Composite">

                                                <Grid x:Name="HistoryHeader"
                                                      Margin="16,10,12,2"
                                                      ColumnSpacing="8"
                                                      Visibility="Collapsed">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="搜索历史"
                                                               Style="{StaticResource SuggestHeaderStyle}" />
                                                    <HyperlinkButton Grid.Column="1"
                                                                     Margin="0,0,2,0"
                                                                     Padding="6,2"
                                                                     FontSize="12"
                                                                     VerticalAlignment="Center"
                                                                     Tag="clear"
                                                                     Click="OnSuggestHeaderClick">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                            <TextBlock Text="清空" FontSize="12" />
                                                        </StackPanel>
                                                    </HyperlinkButton>
                                                </Grid>
                                                <!-- 胶囊按内容宽排、但单颗封顶一行一半（见 SuggestChipStyle）→ 一行两颗；
                                                     四行是可视档（一颗 30 高 + 行距 6：4×30+3×6=138，连下内缩取 140），
                                                     其余往下滚。内缩那 12 是给这条内滚动条让道，别压住右列胶囊。 -->
                                                <ScrollViewer MaxHeight="140"
                                                              Padding="0,0,12,0"
                                                              HorizontalScrollMode="Disabled"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <ItemsRepeater x:Name="HistoryList"
                                                                   Margin="12,0,12,2"
                                                                   AutomationProperties.Name="搜索历史">
                                                        <ItemsRepeater.Layout>
                                                            <LinedFlowLayout MinItemSpacing="8"
                                                                           LineSpacing="6"
                                                                           ItemsJustification="Start"
                                                                           ItemsStretch="None" />
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:SearchSuggestion">
                                                                <Button Style="{StaticResource SuggestChipStyle}"
                                                                        Tag="{x:Bind Word}"
                                                                        Click="OnSuggestRowClick">
                                                                    <TextBlock Text="{x:Bind Word}"
                                                                               Style="{StaticResource BodyTextBlockStyle}"
                                                                               MaxLines="1"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </ScrollViewer>

                                                <Grid x:Name="GuessHeader"
                                                      Margin="16,10,12,2"
                                                      ColumnSpacing="8"
                                                      Visibility="Collapsed">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="猜你想搜"
                                                               Style="{StaticResource SuggestHeaderStyle}" />
                                                    <HyperlinkButton Grid.Column="1"
                                                                     Margin="0,0,2,0"
                                                                     Padding="6,2"
                                                                     FontSize="12"
                                                                     VerticalAlignment="Center"
                                                                     Tag="shuffle"
                                                                     Click="OnSuggestHeaderClick">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                                            <TextBlock Text="换一换" FontSize="12" />
                                                        </StackPanel>
                                                    </HyperlinkButton>
                                                </Grid>
                                                <!-- 两列：一行装两条词，凑不满时右列收掉（官方这一栏就是两列铺开） -->
                                                <ItemsRepeater x:Name="GuessList">
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SearchGuessPair">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button Grid.Column="0"
                                                                        Style="{StaticResource SuggestRowStyle}"
                                                                        Tag="{x:Bind Left}"
                                                                        Click="OnSuggestRowClick">
                                                                    <TextBlock Text="{x:Bind Left}"
                                                                               Style="{StaticResource BodyTextBlockStyle}"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </Button>
                                                                <Button Grid.Column="1"
                                                                        Style="{StaticResource SuggestRowStyle}"
                                                                        Tag="{x:Bind Right}"
                                                                        Visibility="{x:Bind RightVisibility}"
                                                                        Click="OnSuggestRowClick">
                                                                    <TextBlock Text="{x:Bind Right}"
                                                                               Style="{StaticResource BodyTextBlockStyle}"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>

                                                <Grid x:Name="HotHeader"
                                                      Margin="16,10,12,2"
                                                      Visibility="Collapsed">
                                                    <TextBlock Text="抖音热点"
                                                               Style="{StaticResource SuggestHeaderStyle}" />
                                                </Grid>
                                                <ItemsRepeater x:Name="HotList"
                                                               ItemTemplate="{StaticResource SuggestWordRowTemplate}" />
                                            </StackPanel>

                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </AutoSuggestBox>
                </Grid>
            </TitleBar.Content>

            <!-- 右上角账号格：未登录是 E710+圆框，登录后换真头像，点开就是账号菜单。
                 做成独立控件而不是就地写 x:Bind——Window 里的绑定生成类要把根当 FrameworkElement 找转换器，
                 Window 不是 FrameworkElement，带 Converter 的 x:Bind 在 Window 里直接编译不过。
                 放 RightHeader 就够：控件把它贴到可用宽度的最右，命中区也算进它自己那本账，不再单独挖洞。
                 系统那三颗按钮的位置**控件自己已经留好了**（模板第 11 列 RightPaddingColumn 运行时按 AppWindow 的
                 inset 折算成 DIP 占位），所以这里一道 margin 都不要——手搓顶栏时代补的那道 184 已经销账，
                 实测账目见 MainWindow.SetRegionsForCustomTitleBar 上方注释。 -->
            <TitleBar.RightHeader>
                <controls:AccountBadge x:Name="AccountBadgeHost"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,0,0"/>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- 外层 Grid 是缩放骤发的"冻结框"：拖拽期间把内容钉在旧尺寸、只更新这一层的缩放变换，
             NavigationView 里整棵树（两页乒乓、视频面、信息区）就不再逐帧重排重渲——浏览器式的拖拽观感。
             静止时 Width/Height 清空、变换归位，随时回到常规布局。见 UpdateNavFreeze/UnfreezeNav。 -->
        <Grid x:Name="NavFreeze"
              Grid.Row="1">
        <!-- 模板里 MenuItemsScrollViewer/FooterItemsScrollViewer 只写死垂直滚动条，水平属性未设值故走继承（NavigationView.xaml:363/380）；
             内容器被负 margin 撑出胶囊（溢出的是空白盒不是可见内容），关掉水平滚动即可消掉左下角那条滚动条 -->
        <NavigationView x:Name="Nav"
                        PaneDisplayMode="Left"
                        OpenPaneLength="72"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Hidden">

            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewItemButtonMargin">7,2</Thickness>
                <!-- 抵消模板定死的内缩：无图标时图标列仍占 8（generic.xaml:32621），ContentGrid 为折叠箭头预留右侧 14（32734），
                     默认 4/8 下 58 DIP 胶囊只剩 ~24 DIP 放不下竖排图标+文字；负 margin 是该模板自己的手法（32464 箭头 "0,0,-14,0"） -->
                <Thickness x:Key="NavigationViewItemContentPresenterMargin">-8,-1,-14,-1</Thickness>
                <DataTemplate x:Key="NavItemTemplate" x:DataType="local:NavItem">
                    <!-- 竖排项比默认高一倍：9 项在 150% DPI、980px 窗高下会顶出页脚，
                         设置项被裁、页脚滚动条压上来。上下各收 3px，页脚就能整块放下。 -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="5"
                                Margin="0,5">
                        <!-- 页脚「账号」登录后换成真头像；其余项没有 Avatar，照旧画字形 -->
                        <Grid Width="24" Height="24" HorizontalAlignment="Center">
                            <FontIcon Glyph="{x:Bind Glyph}"
                                      FontSize="24"
                                      HorizontalAlignment="Center"
                                      Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                            <Ellipse Width="24"
                                     Height="24"
                                     Visibility="{x:Bind AvatarVisibility, Mode=OneWay}">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{x:Bind Avatar, Mode=OneWay}"
                                                Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="{x:Bind Text}"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
                <!-- 内置设置项的 Content 是本地化字符串（非 NavItem），且不会被 MenuItemTemplate 套用，
                     单独给它一个同款竖排模板；Nav.Loaded 里挂到 SettingsItem -->
                <DataTemplate x:Key="SettingsItemTemplate">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="5"
                                Margin="0,5">
                        <FontIcon Glyph="&#xE713;"
                                  FontSize="24"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding}"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </NavigationView.Resources>

            <NavigationView.MenuItemTemplate>
                <StaticResource ResourceKey="NavItemTemplate" />
            </NavigationView.MenuItemTemplate>

            <NavigationView.MenuItems>
                <local:NavItem TextKey="Nav_Featured" Glyph="&#xE8E1;" Tag="Featured" />
                <local:NavItem TextKey="Nav_ForYou" Glyph="&#xE735;" Tag="ForYou" />
                <local:NavItem TextKey="Nav_Ai" Glyph="&#xE99A;" Tag="Ai" />
                <local:NavItem TextKey="Nav_Following" Glyph="&#xE8FA;" Tag="Following" />
                <local:NavItem TextKey="Nav_Friends" Glyph="&#xE716;" Tag="Friends" />
                <local:NavItem TextKey="Nav_Me" Glyph="&#xE77B;" Tag="Me" />
                <local:NavItem TextKey="Nav_Live" Glyph="&#xE7F4;" Tag="Live" />
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <!-- 页脚只放本人入口：账号 = 登录用户的用户主页（顶部那颗头像菜单仍管登录/消息/退出） -->
                <local:NavItem TextKey="Nav_Account" Glyph="&#xE8D4;" Tag="Account" />
            </NavigationView.FooterMenuItems>

            <!-- 消息面板和评论区同一套“右侧内联面板”：包住 ContentFrame，打开时整页让位，
                 评论区在页面内层，因此自然排在消息面板左侧。导航栏不跟着压缩。 -->
            <SplitView x:Name="MessagesSplit"
                       DisplayMode="Inline"
                       PanePlacement="Right"
                       OpenPaneLength="380"
                       IsPaneOpen="False">
                <SplitView.Pane>
                    <!-- 账号菜单 →「消息」：右侧展开会话列表；点一行进聊天窗（历史/翻页/发送/表情）。
                         关闭走面板右上角 ×（CloseRequested）。 -->
                    <controls:MessagesPanel x:Name="MessagesLayer"
                                            CloseRequested="OnMessagesCloseClick" />
                </SplitView.Pane>
                <SplitView.Content>
                    <Frame x:Name="ContentFrame" />
                </SplitView.Content>
            </SplitView>
        </NavigationView>
        </Grid>

        <!-- 沉浸（程序内全屏）时的关闭按钮：左上角一颗，只有沉浸态才亮；点它就是退出沉浸。
             加速器挂在它自己身上并藏掉展示——挂整窗时 WinUI 会把 Esc 当 tooltip 满窗弹（踩过）。
             顶栏在场时命中区整本账归系统 TitleBar 控件；但沉浸态顶栏收掉了，这颗不在控件里，
             控件管不着，仍要我们挖进 Passthrough 才点得动（见 SetRegionsForCustomTitleBar，现在只剩它）。 -->
        <Button x:Name="ImmersiveCloseButton"
                Grid.RowSpan="2"
                Margin="12,12,0,0"
                Width="36"
                Height="36"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#66000000"
                BorderThickness="0"
                Visibility="Collapsed"
                KeyboardAcceleratorPlacementMode="Hidden"
                Click="OnImmersiveCloseClick">
            <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="#FFFFFFFF" />
            <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="OnImmersiveEscInvoked" />
            </Button.KeyboardAccelerators>
        </Button>

        <!-- 登录面板 = WinUI3 默认样式的 ContentDialog：遮罩、居中浮动卡片都吃系统那一套，不自己刷底色/圆角/投影。
             内容就是 LoginPanel；登录成功面板会自己请宿主 Hide；Esc 兜底收起。
             加速器跟着面板走（不再挂整窗——挂整窗时 WinUI 会把"Esc"当 tooltip 满窗弹），PlacementMode=Hidden 再兜一道。
             宽窄由代码按登录卡片比例（726:483）吃窗口预算，见 FitLoginOverlay；开合见 OpenLoginDialogAsync。 -->
        <ContentDialog x:Name="LoginDialog"
                       Grid.RowSpan="2"
                       KeyboardAcceleratorPlacementMode="Hidden">
            <ContentDialog.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape"
                                     Invoked="OnLoginEscInvoked" />
            </ContentDialog.KeyboardAccelerators>
            <controls:LoginPanel x:Name="LoginOverlayPanel" />
        </ContentDialog>

    </Grid>
</Window>
