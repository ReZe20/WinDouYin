<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinDouYin.Controls.MfStageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinDouYin.Controls"
    xmlns:conv="using:WinDouYin.Converters"
    xmlns:vm="using:WinDouYin.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 音量图标的字形换算：VM 只给"音量是多少"，图标是视图的事（x:Bind 经它转字形） -->
        <conv:VolumeGlyphConverter x:Key="VolumeGlyphConverter" />

        <!-- 弹幕列表行尾那颗心：字形与颜色都由"点没点过"转出来（VM 只吐状态） -->
        <conv:DanmakuLikeGlyphConverter x:Key="DanmakuLikeGlyphConverter" />
        <conv:DanmakuLikeBrushConverter x:Key="DanmakuLikeBrushConverter" />

        <!-- 评论/回复那颗心：赞过是实心 + 系统强调色（评论面板不掺抖音红） -->
        <conv:CommentLikeGlyphConverter x:Key="CommentLikeGlyphConverter" />
        <conv:CommentLikeBrushConverter x:Key="CommentLikeBrushConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 清晰度下拉框那五行：亮/灰由"这条视频有没有这一档"转出来（选中的是哪一行走绑定，不经转换器） -->
        <conv:QualityEnabledConverter x:Key="QualityEnabledConverter" />

        <!-- 弹幕列表每行：卡片底色 + 描边 + 圆角，跟设置卡片同族；行距靠下边 margin 分隔 -->
        <Style x:Key="DanmakuRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6,4,6" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- 面板内按钮：无背景，纯图标 -->
        <Style x:Key="PanelBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <!-- WinUI3 Fluent 设置卡片：圆角 + 卡片底色 + 描边，用于弹幕设置 Flyout 内每一项 -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12,16,12" />
        </Style>
    </UserControl.Resources>

    <!-- Background 用 Transparent 而非 null：视觉上不铺黑底，但保证空白区域仍能命中测试，鼠标移动才能唤出底部面板 -->
    <Grid x:Name="Root" Background="Transparent">
        <!-- 评论面板走 SplitView 的内联（Inline）模式：开合自带动画——面板从右滑入、内容整体让位
             （模板里 PaneTransform/ContentTransform 各跑一段 0.2s 样条）。Pane 只放评论面板；
             视频/信息/控制条/交互列/提示全在 Content 里，跟着一起挤压。 -->
        <SplitView x:Name="CommentSplit"
                   DisplayMode="Inline"
                   PanePlacement="Right"
                   OpenPaneLength="360"
                   IsPaneOpen="False">
            <SplitView.Pane>
                <!-- 评论面板：WinUI 3 风格——系统主题底色、标准文字样式、系统强调色做链接与发送按钮。
                     面板本身不再套圆角卡，只留左侧分隔线；圆角卡只用在单条评论/回复上。
                     点评论按钮开合、右上角 × 收起；列表=第一页 20 条，滚到底自动续页。 -->
                <Border x:Name="CommentPanel"
                        VerticalAlignment="Stretch"
                        Padding="16,12,16,12"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 头：标题括号里直接写服务端的总评论数（取到第一页后才知道）；收起点在右边 -->
                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CommentTitleText"
                                       Text="评论"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource PanelBtnStyle}"
                                    ToolTipService.ToolTip="收起评论"
                                    Click="OnCommentCloseClick">
                                <FontIcon FontSize="14" Glyph="&#xE711;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </Grid>

                        <!-- 列表：滚到底自动要下一页。临时状态（正在取 / 还没评论）盖在列表中央，
                             取到东西或列表空态结束就收起，不再单独占一行。
                             分享卡来源评论不另造卡：按 cid 找到那一行后移到最上面、卡头显示“置顶”。 -->
                        <Grid Grid.Row="1">
                        <ScrollViewer x:Name="CommentScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Auto"
                                      ViewChanged="OnCommentScrollChanged">
                            <ItemsControl ItemsSource="{x:Bind CommentRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CommentRowViewModel">
                                        <!-- 一级评论卡（与回复卡共用 CommentCardStyle）；它的直接回复卡/加载更多都在这张卡里面 -->
                                        <Border Style="{StaticResource CommentCardStyle}"
                                                Padding="12"
                                                Margin="0,0,4,8">
                                            <StackPanel Spacing="8">
                                                <!-- 来源评论置顶：整张卡就是普通评论，只多这一行 -->
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="4"
                                                            Visibility="{x:Bind PinnedVisibility, Mode=OneWay}">
                                                    <FontIcon Glyph="&#xE718;"
                                                              FontSize="10"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="置顶"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <!-- 评论头：头像 + 昵称/正文/尾注 -->
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 头像：avatar_thumb（100×100）；没有图就摆昵称首字 -->
                                                    <PersonPicture Width="36"
                                                                   Height="36"
                                                                   VerticalAlignment="Top"
                                                                   ProfilePicture="{x:Bind Avatar}"
                                                                   Initials="{x:Bind Initials}" />
                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock Text="{x:Bind Author}"
                                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                        <!-- 正文：官方表情码在同一段文字里换成图（见 EmojiText） -->
                                                        <RichTextBlock controls:EmojiText.Text="{x:Bind Text}"
                                                                       FontSize="14"
                                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                       TextWrapping="Wrap" />
                                                        <!-- 图片评论：单图按原比例画（点开看原图）；多图摆 3 列方网格 -->
                                                        <Button Tag="{x:Bind SingleImageUrl}"
                                                                Visibility="{x:Bind SingleImageVisibility}"
                                                                Padding="0"
                                                                BorderThickness="0"
                                                                Background="Transparent"
                                                                HorizontalAlignment="Left"
                                                                Click="OnCommentImageClick">
                                                            <Image Source="{x:Bind SingleImageSource}"
                                                                   Width="{x:Bind SingleImageWidth}"
                                                                   Height="{x:Bind SingleImageHeight}"
                                                                   Stretch="Uniform" />
                                                        </Button>
                                                        <ItemsRepeater ItemsSource="{x:Bind Images}"
                                                                       Visibility="{x:Bind ImageGridVisibility}">
                                                            <ItemsRepeater.Layout>
                                                                <UniformGridLayout MinItemWidth="80"
                                                                                   MinItemHeight="80"
                                                                                   MinRowSpacing="6"
                                                                                   MinColumnSpacing="6"
                                                                                   ItemsStretch="Fill"
                                                                                   MaximumRowsOrColumns="3" />
                                                            </ItemsRepeater.Layout>
                                                            <ItemsRepeater.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:CommentImageViewModel">
                                                                    <Button Tag="{x:Bind Url}"
                                                                            Padding="0"
                                                                            BorderThickness="0"
                                                                            Background="Transparent"
                                                                            Click="OnCommentImageClick">
                                                                        <Image Source="{x:Bind Source}"
                                                                               Width="80"
                                                                               Height="80"
                                                                               Stretch="UniformToFill" />
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsRepeater.ItemTemplate>
                                                        </ItemsRepeater>
                                                        <!-- 表情包：按原比例画，点开也能放大 -->
                                                        <Button Tag="{x:Bind StickerUrl}"
                                                                Visibility="{x:Bind StickerVisibility}"
                                                                Padding="0"
                                                                BorderThickness="0"
                                                                Background="Transparent"
                                                                HorizontalAlignment="Left"
                                                                Click="OnCommentImageClick">
                                                            <Image Source="{x:Bind StickerSource}"
                                                                   Width="{x:Bind StickerWidth}"
                                                                   Height="{x:Bind StickerHeight}"
                                                                   Stretch="Uniform" />
                                                        </Button>
                                                        <!-- 尾注：时间在左，回复/点赞按钮在右（心 + 赞数；赞过是实心 + 系统强调色） -->
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind Meta}"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="1"
                                                                    Padding="4,1"
                                                                    MinHeight="0"
                                                                    MinWidth="0"
                                                                    BorderThickness="0"
                                                                    Background="Transparent"
                                                                    HorizontalAlignment="Right"
                                                                    ToolTipService.ToolTip="回复这条评论"
                                                                    Click="OnCommentReplyClick">
                                                                <TextBlock Text="回复"
                                                                           FontSize="12"
                                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                           VerticalAlignment="Center" />
                                                            </Button>
                                                            <Button Grid.Column="2"
                                                                    Padding="4,1"
                                                                    MinHeight="0"
                                                                    MinWidth="0"
                                                                    BorderThickness="0"
                                                                    Background="Transparent"
                                                                    HorizontalAlignment="Right"
                                                                    ToolTipService.ToolTip="赞这条评论"
                                                                    Click="OnCommentLikeClick">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <FontIcon FontSize="12"
                                                                              Glyph="{x:Bind Liked, Mode=OneWay, Converter={StaticResource CommentLikeGlyphConverter}}"
                                                                              Foreground="{x:Bind Liked, Mode=OneWay, Converter={StaticResource CommentLikeBrushConverter}}" />
                                                                    <TextBlock Text="{x:Bind LikeLabel, Mode=OneWay}"
                                                                               FontSize="12"
                                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 回复区脱离正文列、铺满一级卡宽度；每张回复卡再递归包住子回复卡，
                                                     所有层级的卡片左缘对齐，不再逐级缩进。 -->
                                                <ItemsControl ItemsSource="{x:Bind Replies}"
                                                              Visibility="{x:Bind RepliesVisibility, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:CommentReplyRowViewModel">
                                                            <controls:ReplyCardControl ImageTapped="OnCommentImageTapped" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- "展开N条回复" / "收起回复" + "加载更多回复"：与正文左缘对齐 -->
                                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="48,0,0,0">
                                                    <HyperlinkButton Content="{x:Bind ExpandLabel, Mode=OneWay}"
                                                                     Visibility="{x:Bind ExpandVisibility}"
                                                                     FontSize="12"
                                                                     Padding="0,2,0,2"
                                                                     MinHeight="0"
                                                                     Click="OnReplyExpandClick" />
                                                    <HyperlinkButton Content="{x:Bind MoreRepliesLabel, Mode=OneWay}"
                                                                     Visibility="{x:Bind MoreRepliesVisibility, Mode=OneWay}"
                                                                     FontSize="12"
                                                                     Padding="0,2,0,2"
                                                                     MinHeight="0"
                                                                     Click="OnMoreRepliesClick" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 临时状态：只写"正在取/还没评论"这类话；不再报已加载条数与总数 -->
                        <TextBlock x:Name="CommentStatus"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed" />
                        </Grid>

                        <!-- 尾：发评论（Enter 或点"发送"）。输入框与弹幕那格一样用 RichEditBox——
                             只有它能把官方表情图当正文的一部分显示；发送时靠透明标签把码还回来。 -->
                        <Grid Grid.Row="2" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- 回复目标提示：点了某条评论/回复的"回复"后出现，点取消回到发一级评论。 -->
                            <Grid x:Name="CommentReplyToPanel" Grid.Row="0" ColumnSpacing="8" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CommentReplyToText"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource PanelBtnStyle}"
                                        Padding="4"
                                        ToolTipService.ToolTip="取消回复"
                                        Click="OnCancelReplyClick">
                                    <FontIcon FontSize="12" Glyph="&#xE711;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Button>
                            </Grid>
                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                            <!-- 高度不写死：随输入折行自动长高，到 MaxHeight 后内部滚动；清空后自己缩回一行。 -->
                            <RichEditBox x:Name="CommentInput"
                                         MinHeight="34"
                                         MaxHeight="120"
                                         Padding="8,4,8,4"
                                         PlaceholderText="发一条评论…"
                                         AcceptsReturn="False"
                                         IsSpellCheckEnabled="False"
                                         IsTextPredictionEnabled="False"
                                         KeyDown="OnCommentInputKeyDown" />
                            <!-- 表情：与弹幕共用官方那一套表，点一个插进光标处。
                                 不改 Button 样式：就用 WinUI 3 默认按钮的受击框、悬停与焦点视觉。 -->
                            <Button x:Name="CommentEmojiButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    ToolTipService.ToolTip="表情"
                                    Height="33">
                                <FontIcon FontSize="16" Glyph="&#xE76E;" />
                                <Button.Flyout>
                                    <Flyout x:Name="CommentEmojiFlyout" Placement="Top" Opened="OnCommentEmojiFlyoutOpened">
                                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="CommentEmojiHost" Width="288" Spacing="2" Margin="0,0,8,0" />
                                        </ScrollViewer>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="CommentSendButton"
                                    Grid.Column="2"
                                    Style="{StaticResource AccentButtonStyle}"
                                    MinWidth="0"
                                    VerticalAlignment="Bottom"
                                    ToolTipService.ToolTip="发送评论"
                                    Content="发送"
                                    Click="OnCommentSendClick" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </SplitView.Pane>
            <SplitView.Content>
                <Grid>
        <!-- 单通道视频层：视频按画面比例居中，四周让给模糊封面。
             铺满整个可用区——早前给右侧交互列预留的 60px 边距已取消，点赞/评论等直接浮在视频上。 -->
        <controls:HandCursorLayer x:Name="Layer">
            <Image x:Name="CoverImage" Stretch="UniformToFill" />
            <Grid x:Name="VideoHost" Background="Transparent">
                <MediaPlayerElement x:Name="Video"
                                    AreTransportControlsEnabled="False"
                                    Stretch="Uniform"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch" />
            </Grid>

            <!-- 图文层：图文帖（imagepost://）不走 MF 播放器，图铺满整层显示。
                 尺寸全交给 Stretch：整层多大，图就等比缩放到多大，窗口一变自动跟着变。
                 翻页用两张叠着的 Image 做横向滑入滑出（切完把新图落到主图上）。
                 实况图（live_photo）：带实拍 mp4 的那页上把 LiveVideo 叠在图上，播完渐显到静态图、停一秒，再往后切。
                 命中测试只在可见时吃事件，平时 Collapsed 不挡视频。 -->
            <Grid x:Name="ImageGallery"
                  Visibility="Collapsed"
                  Background="Black">
                <Image x:Name="ImageStill"
                       IsHitTestVisible="False"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="ImageStillTransform" />
                    </Image.RenderTransform>
                </Image>

                <!-- 翻页时从侧面滑进来的下一张；落定后它的图搬到 ImageStill 上 -->
                <Image x:Name="ImageIncoming"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="ImageIncomingTransform" />
                    </Image.RenderTransform>
                </Image>

                <!-- 实况视频覆盖层：当前页带实拍时铺在图上，播到尾由上面这张 LiveStill
                     渐显盖住尾帧、停一秒，再往后切（就一张或幕外候场时回零重播）——
                     静态图由图文帖决定，不是视频首帧。尺寸同样交给 Stretch，随窗口变。 -->
                <MediaPlayerElement x:Name="LiveVideo"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False"
                                    AutoPlay="True"
                                    AreTransportControlsEnabled="False"
                                    Stretch="Uniform"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch" />

                <!-- 尾帧 → 静态图的介质：播完把同一页的静态图从上层渐显盖住尾帧，
                     视频本身不改透明度（尾帧始终不透明）。 -->
                <Image x:Name="LiveStill"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"
                       Opacity="0"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />

                <TextBlock x:Name="ImagePagerText"
                           Margin="0,0,12,12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           IsHitTestVisible="False"
                           FontSize="14"
                           Foreground="White" />
            </Grid>

            <!-- 手势层：接收拖拽换台、单击暂停、双击点赞。**必须排在图文层之后**——
                 图文帖的 ImageGallery 带黑底、整层吃命中，摆它前面手势层就永远收不到指针。
                 再上面是弹幕层（Canvas 留白不吃鼠标），弹幕字仍然优先命中。
                 普通视频的滚轮这里不处理，继续冒泡给宿主页面；图文帖的滚轮转交 WheelRolled。 -->
            <Border x:Name="GestureLayer" Background="Transparent">
                <!-- 视频画面的右键菜单：只放"对这条视频的操作"，不复刻底栏的播放/倍速/点赞那套。
                     只挂在这层上，评论面板/右侧竖排/底栏右键不会弹。 -->
                <Border.ContextFlyout>
                    <MenuFlyout x:Name="VideoContextMenu"
                                Opening="OnVideoContextMenuOpening">
                        <MenuFlyoutItem Text="视频信息…"
                                        Click="OnContextVideoInfoClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator />

                        <MenuFlyoutItem Text="复制视频链接"
                                        Click="OnContextCopyLinkClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="在浏览器中打开"
                                        Click="OnContextOpenBrowserClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="CtxSaveVideo"
                                        Text="保存视频…"
                                        Click="OnContextSaveVideoClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE896;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="系统分享…"
                                        Click="OnContextSystemShareClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator />

                        <MenuFlyoutItem x:Name="CtxReload"
                                        Text="重新加载视频"
                                        Click="OnContextReloadClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72C;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Border.ContextFlyout>
            </Border>

            <!-- 弹幕层：盖在画面上。**留白处不吃鼠标**（Canvas 没有 Background，命中测试只落在字上），
                 所以点空白照旧穿透到视频、面板；点在字上则开那条弹幕的操作（复制/屏蔽）。
                 运动是每条一个合成器动画（见 PushDanmaku），暂停/拖拽/倍速都跟着视频时间走。 -->
            <Canvas x:Name="DanmakuLayer" />
        </controls:HandCursorLayer>

        <!-- 信息区：不参与浮动面板显隐，常驻；但有自己的位移变换，面板上浮时跟着一起上浮 -->
        <controls:VideoInfoControl x:Name="Info">
            <controls:VideoInfoControl.RenderTransform>
                <TranslateTransform x:Name="InfoTransform" />
            </controls:VideoInfoControl.RenderTransform>
        </controls:VideoInfoControl>

        <!-- 加载/缓冲提示：换台装载中或播放器 Buffering 时亮，播起来或出错即收 -->
        <ProgressRing x:Name="StageLoading"
                      Width="44"
                      Height="44"
                      Foreground="#FFFFFFFF"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="False"
                      Visibility="Collapsed" />

        <!-- ====== 底部浮动面板（两层） ======
             上层：进度条 Slider 跨满宽度
             下层：仿抖音官网——左侧 播放+时间+章节+弹幕区；右侧 连播+清屏+智能+倍速+设置+小窗+音量+全屏
             音量是点击图标弹出 Popup 里的滑块，不内联。 -->
        <Border x:Name="ControlPanel"
                VerticalAlignment="Bottom"
                Margin="16,0,16,16"
                Background="#B31A1A1A"
                CornerRadius="8"
                Padding="8,2,8,2">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PanelTransform" />
            </Border.RenderTransform>

            <StackPanel>
                <!-- 第一层：视频是整条进度，图文帖按图片数分段（当前段高亮）。 -->
                <Grid Margin="4,0,4,0"
                      MinHeight="24">
                    <Slider x:Name="ProgressSlider"
                            Minimum="0"
                            Maximum="1"
                            Value="0"
                            ToolTipService.ToolTip="进度" />
                    <!-- 图文进度：每张一段，点亮当前段。段本身就是点击热区（整格 24 高），
                         里面那根 4 高的条才是画出来的样子——4 高的东西点不着。 -->
                    <Grid x:Name="ImageProgressBar"
                          Visibility="Collapsed"
                          Height="24"
                          VerticalAlignment="Center"
                          ColumnSpacing="3" />
                </Grid>

                <!-- 第二层：左右两组 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧组 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 播放/暂停 -->
                        <Button x:Name="PlayPauseButton"
                                Style="{StaticResource PanelBtnStyle}"
                                ToolTipService.ToolTip="播放/暂停"
                                Click="OnPlayPauseClick">
                            <FontIcon x:Name="PlayPauseIcon"
                                      FontSize="16"
                                      Glyph="&#xE769;"
                                      Foreground="#FFFFFFFF" />
                        </Button>

                        <!-- 时间 -->
                        <TextBlock x:Name="TimeLabel"
                                   VerticalAlignment="Center"
                                   Margin="4,0,8,0"
                                   FontSize="12"
                                   Foreground="#CCFFFFFF"
                                   Text="00:00 / 00:00" />

                        <!-- 章节信息（抖音长视频有，短视频无数据时隐藏） -->
                        <TextBlock x:Name="ChapterLabel"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   FontSize="12"
                                   Foreground="#CCFFFFFF"
                                   Visibility="Collapsed" />

                        <!-- 弹幕开关 -->
                        <ToggleButton x:Name="DanmakuToggle"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="6,4"
                                      Foreground="#FFFFFFFF"
                                      ToolTipService.ToolTip="弹幕开关"
                                      Checked="OnDanmakuToggle"
                                      Unchecked="OnDanmakuToggle">
                            <TextBlock Text="弹" FontSize="14" />
                        </ToggleButton>

                        <!-- 弹幕输入：**RichEditBox 不是 TextBox**——只有它能把官方表情图当正文的一部分显示
                             （TextBox 嵌不了图）。插进去的是真图片，码靠一个 1px 透明的标签字符跟着，
                             取发送文本时再把码还回来（见 InsertEmojiAsync / DanmakuText）。 -->
                        <RichEditBox x:Name="DanmakuInput"
                                     VerticalAlignment="Center"
                                     Margin="4,0,0,0"
                                     Width="160"
                                     Height="32"
                                     Padding="8,4,8,4"
                                     FontSize="14"
                                     AcceptsReturn="False"
                                     IsSpellCheckEnabled="False"
                                     IsTextPredictionEnabled="False"
                                     PlaceholderText="发一条友好的弹幕吧" />

                        <!-- 表情：抖音官方那一套（码与正文里的 [微笑] 同源），点一个就往输入框里插一个 -->
                        <Button x:Name="EmojiButton"
                                Style="{StaticResource PanelBtnStyle}"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="表情">
                            <FontIcon FontSize="16" Glyph="&#xE76E;" Foreground="#CCFFFFFF" />
                            <Button.Flyout>
                                <Flyout x:Name="EmojiFlyout" Placement="Top" Opened="OnEmojiFlyoutOpened">
                                    <!-- 右侧留 8px：滚动条是浮在内容上的，不留就会压住最后一列 -->
                                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="EmojiHost" Width="288" Spacing="2" Margin="0,0,8,0" />
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- 发送弹幕 -->
                        <Button x:Name="DanmakuSendButton"
                                Style="{StaticResource PanelBtnStyle}"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="发送弹幕"
                                Click="OnDanmakuSend">
                            <TextBlock Text="发送" FontSize="12" Foreground="#FE2C55" />
                        </Button>

                        <!-- 弹幕设置：点击弹出 Flyout -->
                        <Button x:Name="DanmakuSettingsButton"
                                Style="{StaticResource PanelBtnStyle}"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="弹幕设置">
                            <!-- 弹幕列表：从下面那行"弹幕列表"点出来，弹在**这颗按钮正上方**（同一个锚点）。
                                 行样全在这（数据由 DanmakuListRows 喂，打开时铺一版快照）；
                                 右侧留 12px：滚动条是浮在内容上的，行有描边，不留就会压住行的右缘。 -->
                            <FlyoutBase.AttachedFlyout>
                                <Flyout x:Name="DanmakuListFlyout" Placement="Top">
                                    <Grid>
                                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{x:Bind DanmakuListRows}"
                                                          Width="340"
                                                          Margin="0,0,12,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:DanmakuRowViewModel">
                                                        <Border Style="{StaticResource DanmakuRowStyle}">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{x:Bind DisplayText}"
                                                                           TextWrapping="Wrap"
                                                                           VerticalAlignment="Center" />
                                                                <!-- 行尾的心：空心 ↔ 实心（点过染红）。字形与颜色都是视图的事，x:Bind 经转换器转 -->
                                                                <Button Grid.Column="1"
                                                                        Style="{StaticResource PanelBtnStyle}"
                                                                        Padding="6,3,8,3"
                                                                        MinWidth="0"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{x:Bind CanLike, Converter={StaticResource BoolToVisibility}}"
                                                                        Click="OnDanmakuRowLike">
                                                                    <FontIcon FontSize="14"
                                                                              Glyph="{x:Bind Liked, Mode=OneWay, Converter={StaticResource DanmakuLikeGlyphConverter}}"
                                                                              Foreground="{x:Bind Liked, Mode=OneWay, Converter={StaticResource DanmakuLikeBrushConverter}}" />
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <!-- 空态：条数一变这两个函数绑定自己重来 -->
                                        <TextBlock Text="{x:Bind DanmakuListHint(DanmakuListRows.Count), Mode=OneWay}"
                                                   Visibility="{x:Bind DanmakuListHintVisible(DanmakuListRows.Count), Mode=OneWay}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,12,0" />
                                    </Grid>
                                </Flyout>
                            </FlyoutBase.AttachedFlyout>
                            <FontIcon FontSize="16" Glyph="&#xE115;" Foreground="#CCFFFFFF" />
                            <Button.Flyout>
                                <Flyout x:Name="DanmakuSettingsFlyout" Placement="Top">
                                    <StackPanel Width="320" Spacing="6">
                                        <!-- 标题行：左标题 + 右恢复默认 -->
                                        <Grid Margin="2,0,2,8">
                                            <TextBlock Text="弹幕设置" Style="{ThemeResource TitleTextBlockStyle}" FontSize="18" VerticalAlignment="Center" />
                                            <Button x:Name="DanmakuResetButton"
                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                    HorizontalAlignment="Right"
                                                    Click="OnDanmakuReset">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                                    <TextBlock Text="恢复默认" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- 不透明度：标题+值在上，滑块在下 -->
                                        <Border Style="{StaticResource SettingsCardStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="不透明度" Style="{ThemeResource BodyTextBlockStyle}" />
                                                    <TextBlock x:Name="DanmakuOpacityText"
                                                               Text="80%"
                                                               Style="{ThemeResource BodyTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                                <Slider x:Name="DanmakuOpacitySlider"
                                                        Margin="0,8,0,0"
                                                        Minimum="0"
                                                        Maximum="100"
                                                        Value="80"
                                                        ValueChanged="OnDanmakuOpacityChanged" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 显示区域 -->
                                        <Border Style="{StaticResource SettingsCardStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="显示区域" Style="{ThemeResource BodyTextBlockStyle}" />
                                                    <TextBlock x:Name="DanmakuAreaText"
                                                               Text="两行"
                                                               Style="{ThemeResource BodyTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                                <Slider x:Name="DanmakuAreaSlider"
                                                        Margin="0,8,0,0"
                                                        Minimum="0"
                                                        Maximum="2"
                                                        Value="1"
                                                        TickFrequency="1"
                                                        SnapsTo="Ticks"
                                                        ValueChanged="OnDanmakuAreaChanged" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 字体大小 -->
                                        <Border Style="{StaticResource SettingsCardStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="字体大小" Style="{ThemeResource BodyTextBlockStyle}" />
                                                    <TextBlock x:Name="DanmakuFontText"
                                                               Text="适中"
                                                               Style="{ThemeResource BodyTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                                <Slider x:Name="DanmakuFontSlider"
                                                        Margin="0,8,0,0"
                                                        Minimum="0"
                                                        Maximum="2"
                                                        Value="1"
                                                        TickFrequency="1"
                                                        SnapsTo="Ticks"
                                                        ValueChanged="OnDanmakuFontChanged" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 移动速度 -->
                                        <Border Style="{StaticResource SettingsCardStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="移动速度" Style="{ThemeResource BodyTextBlockStyle}" />
                                                    <TextBlock x:Name="DanmakuSpeedText"
                                                               Text="适中"
                                                               Style="{ThemeResource BodyTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                                <Slider x:Name="DanmakuSpeedSlider"
                                                        Margin="0,8,0,0"
                                                        Minimum="0"
                                                        Maximum="2"
                                                        Value="1"
                                                        TickFrequency="1"
                                                        SnapsTo="Ticks"
                                                        ValueChanged="OnDanmakuSpeedChanged" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 弹幕列表：整行可点，右箭头 -->
                                        <Button x:Name="DanmakuListButton"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnDanmakuList">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <Grid>
                                                    <TextBlock Text="弹幕列表" Style="{ThemeResource BodyTextBlockStyle}" />
                                                    <FontIcon FontSize="14"
                                                              Glyph="&#xE76C;"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- 右侧组 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 连播 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0"
                                    ToolTipService.ToolTip="连播">
                            <TextBlock Text="连播" FontSize="12" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="AutoPlayToggle"
                                          OnContent="" OffContent=""
                                          MinWidth="0"
                                          Margin="6,0,0,0" />
                        </StackPanel>

                        <!-- 清屏 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0"
                                    ToolTipService.ToolTip="清屏">
                            <TextBlock Text="清屏" FontSize="12" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="ClearScreenToggle"
                                          OnContent="" OffContent=""
                                          MinWidth="0"
                                          Margin="6,0,0,0"
                                          Toggled="OnClearScreenToggled" />
                        </StackPanel>

                        <!-- 智能、设置两颗按钮按用户要求去掉（弹幕的设置那枚另在左侧弹幕区） -->

                        <!-- 倍速：按钮上是当前档，点开是预设值（Flyout 里的单选菜单） -->
                        <Button x:Name="SpeedButton" Style="{StaticResource PanelBtnStyle}"
                                ToolTipService.ToolTip="倍速">
                            <TextBlock x:Name="SpeedLabel" Text="1x" FontSize="12" Foreground="#CCFFFFFF" />
                            <Button.Flyout>
                                <MenuFlyout Placement="Top">
                                    <RadioMenuFlyoutItem Text="0.75x" Tag="0" GroupName="Speed" Click="OnSpeedPick" />
                                    <RadioMenuFlyoutItem Text="1x" Tag="1" GroupName="Speed" Click="OnSpeedPick" IsChecked="True" />
                                    <RadioMenuFlyoutItem Text="1.25x" Tag="2" GroupName="Speed" Click="OnSpeedPick" />
                                    <RadioMenuFlyoutItem Text="1.5x" Tag="3" GroupName="Speed" Click="OnSpeedPick" />
                                    <RadioMenuFlyoutItem Text="2x" Tag="4" GroupName="Speed" Click="OnSpeedPick" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <!-- 清晰度：形制与倍速一模一样（按钮脸显示**正在放**的那一档，点开是单选菜单，同一套 PanelBtnStyle）。
                             档位数据来自 feed 的 video.bit_rate[]（摊表那步在取数层，源码只在私有仓 WinDouYin-dev），选中即落设置、跨视频沿用；
                             没有的档置灰（由 Quality.Available 经转换器算出来），正在放的那一档那枚点由 SyncQualityMenu
                             从代码里摆——与倍速的 SyncSpeedFlyout 同一路（RadioMenuFlyoutItem 的点从绑定驱动时不渲染）。 -->
                        <Button x:Name="QualityButton" Style="{StaticResource PanelBtnStyle}"
                                ToolTipService.ToolTip="清晰度">
                            <TextBlock Text="{x:Bind Quality.CurrentLabel, Mode=OneWay}" FontSize="12" Foreground="#CCFFFFFF" />
                            <Button.Flyout>
                                <MenuFlyout Placement="Top">
                                    <RadioMenuFlyoutItem Text="2160P" Tag="2160" GroupName="Quality" Click="OnQualityPick"
                                                         IsEnabled="{x:Bind Quality.Available, Mode=OneWay, Converter={StaticResource QualityEnabledConverter}, ConverterParameter=2160}" />
                                    <RadioMenuFlyoutItem Text="1440P" Tag="1440" GroupName="Quality" Click="OnQualityPick"
                                                         IsEnabled="{x:Bind Quality.Available, Mode=OneWay, Converter={StaticResource QualityEnabledConverter}, ConverterParameter=1440}" />
                                    <RadioMenuFlyoutItem Text="1080P" Tag="1080" GroupName="Quality" Click="OnQualityPick"
                                                         IsEnabled="{x:Bind Quality.Available, Mode=OneWay, Converter={StaticResource QualityEnabledConverter}, ConverterParameter=1080}" />
                                    <RadioMenuFlyoutItem Text="720P" Tag="720" GroupName="Quality" Click="OnQualityPick"
                                                         IsEnabled="{x:Bind Quality.Available, Mode=OneWay, Converter={StaticResource QualityEnabledConverter}, ConverterParameter=720}" />
                                    <RadioMenuFlyoutItem Text="540P" Tag="540" GroupName="Quality" Click="OnQualityPick"
                                                         IsEnabled="{x:Bind Quality.Available, Mode=OneWay, Converter={StaticResource QualityEnabledConverter}, ConverterParameter=540}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <!-- 稍后再看：加入抖音那边「稍后再看」（系统收藏夹）。接口侧见 IDouyinFeed.WatchLaterAddAsync——
                             今天这条路被 Argus 签名墙挡着，点下去会把服务端的原话弹在屏上。 -->
                        <Button x:Name="WatchLaterButton" Style="{StaticResource PanelBtnStyle}"
                                ToolTipService.ToolTip="加入稍后再看"
                                Click="OnWatchLaterClick">
                            <FontIcon x:Name="WatchLaterIcon" FontSize="16" Glyph="&#xF0B5;" Foreground="#CCFFFFFF" />
                        </Button>

                        <!-- 小窗：缩成 400×225 的置顶小窗钉在屏幕右下角，再点一次还原（见 ToggleMiniWindow） -->
                        <Button x:Name="PipButton" Style="{StaticResource PanelBtnStyle}"
                                ToolTipService.ToolTip="小窗"
                                Click="OnPipClick">
                            <FontIcon x:Name="PipIcon" FontSize="16" Glyph="&#xE78B;" Foreground="#CCFFFFFF" />
                        </Button>

                        <!-- 音量：鼠标停上去就亮出滑块条；点图标本身在"静音 / 上一次的音量"之间来回 -->
                        <Button x:Name="VolumeButton" Style="{StaticResource PanelBtnStyle}"
                                ToolTipService.ToolTip="音量"
                                Click="OnVolumeClick"
                                PointerEntered="OnVolumePointerEntered"
                                PointerExited="OnVolumePointerExited">
                            <FontIcon Glyph="{x:Bind Settings.Volume, Mode=OneWay, Converter={StaticResource VolumeGlyphConverter}}"
                                      FontSize="16"
                                      Foreground="#CCFFFFFF" />
                            <Button.Flyout>
                                <Flyout x:Name="VolumeFlyout" Placement="Top">
                                    <!-- 默认 FlyoutPresenter 有 MinWidth=96，音量条只有一根滑块，用不着那么宽 -->
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="Padding" Value="8" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel Width="32" HorizontalAlignment="Center"
                                                PointerEntered="OnVolumeFlyoutPointerEntered"
                                                PointerExited="OnVolumeFlyoutPointerExited">
                                        <!-- 这里**不写** Value：XAML 里的初值会在载入时就触发一次 ValueChanged，
                                             经双向绑定反过来把设置里的音量冲成初值（每启动一次冲一次）。
                                             初值一律由 ApplyVolume 从设置灌进来；事件也在代码里接（见构造函数）。 -->
                                        <Slider x:Name="VolumeSlider"
                                                Orientation="Vertical"
                                                Width="32"
                                                Height="100"
                                                Minimum="0"
                                                Maximum="100"
                                                SmallChange="1"
                                                LargeChange="10"
                                                HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Settings.VolumeText, Mode=OneWay}"
                                                   FontSize="11"
                                                   Foreground="#FFFFFFFF"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- 程序内全屏：藏掉侧边栏与顶栏（窗口外壳配合，见 Chrome/ApplyImmersive），
                             左上角随之亮一颗关闭按钮；再点一次回来 -->
                        <Button x:Name="ImmersiveButton" Style="{StaticResource PanelBtnStyle}"
                                ToolTipService.ToolTip="程序内全屏"
                                Click="OnImmersiveClick">
                            <FontIcon x:Name="ImmersiveIcon" FontSize="16" Glyph="&#xEF20;" Foreground="#CCFFFFFF" />
                        </Button>

                        <!-- 全屏（真·全屏：AppWindow 换成 FullScreenPresenter） -->
                        <Button x:Name="FullscreenButton" Style="{StaticResource PanelBtnStyle}"
                                ToolTipService.ToolTip="全屏"
                                Click="OnFullscreenClick">
                            <FontIcon FontSize="16" Glyph="&#xE740;" Foreground="#CCFFFFFF" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 右侧竖排交互列：作者头像 + 点赞 + 评论 + 收藏 + 转发，直接浮在视频右缘之上 -->
        <StackPanel x:Name="RightRail"
                    Width="60"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,90"
                    Spacing="20">
            <!-- 作者头像 -->
            <Button x:Name="AuthorAvatarButton"
                    Style="{StaticResource PanelBtnStyle}"
                    HorizontalAlignment="Center"
                    ToolTipService.ToolTip="作者主页"
                    Click="OnAuthorClick">
                <Ellipse x:Name="AuthorAvatar" Width="40" Height="40">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="AuthorAvatarBrush" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </Button>

            <!-- 点赞 -->
            <Button x:Name="LikeButton"
                    Style="{StaticResource PanelBtnStyle}"
                    HorizontalAlignment="Center"
                    ToolTipService.ToolTip="点赞"
                    Click="OnLikeClick">
                <StackPanel>
                    <FontIcon x:Name="LikeGlyph" FontSize="28" Glyph="&#xEB51;" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                    <TextBlock x:Name="LikeCount" Text="0" FontSize="11" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- 评论：点开/收起右侧那条评论面板（见上面的 CommentPanel） -->
            <Button x:Name="CommentButton"
                    Style="{StaticResource PanelBtnStyle}"
                    HorizontalAlignment="Center"
                    ToolTipService.ToolTip="评论"
                    Click="OnCommentClick">
                <StackPanel>
                    <FontIcon FontSize="28" Glyph="&#xE8BD;" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CommentCount" Text="0" FontSize="11" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- 收藏：悬停出收藏夹小面板（勾选后关面板才写），直接点仍是默认收藏 -->
            <Button x:Name="FavoriteButton"
                    Style="{StaticResource PanelBtnStyle}"
                    HorizontalAlignment="Center"
                    ToolTipService.ToolTip="收藏（悬停选择收藏夹）"
                    PointerEntered="OnFavoritePointerEntered"
                    PointerExited="OnFavoritePointerExited"
                    Click="OnFavoriteClick">
                <StackPanel>
                    <FontIcon x:Name="FavoriteGlyph" FontSize="28" Glyph="&#xE734;" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                    <TextBlock x:Name="FavoriteCount" Text="0" FontSize="11" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- 转发/分享：面板里可以发给应用内会话、复制链接或走 Windows 系统分享 -->
            <Button x:Name="RepostButton"
                    Style="{StaticResource PanelBtnStyle}"
                    HorizontalAlignment="Center"
                    ToolTipService.ToolTip="分享"
                    PointerEntered="OnRepostPointerEntered">
                <Button.Flyout>
                    <Flyout x:Name="ShareFlyout"
                            Placement="Top"
                            Opening="OnShareFlyoutOpening">
                        <StackPanel Width="320"
                                    Spacing="4">
                            <TextBlock Text="分享给朋友"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       Margin="4,0,4,4" />

                            <ListView x:Name="ShareTargetList"
                                      MaxHeight="240"
                                      Padding="0"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="OnShareTargetClick"
                                      Visibility="Collapsed">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ShareTargetRow">
                                        <Grid MinHeight="40"
                                              ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <PersonPicture Width="32"
                                                           Height="32"
                                                           ProfilePicture="{x:Bind Avatar}"
                                                           Initials="{x:Bind Initials}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Name}"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel x:Name="ShareLoadingRow"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="4,4,4,4"
                                        Visibility="Collapsed">
                                <ProgressRing x:Name="ShareTargetRing"
                                              Width="16"
                                              Height="16"
                                              IsActive="False" />
                                <TextBlock Text="正在读取朋友列表…"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock x:Name="ShareTargetStatus"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="4,2,4,2" />

                            <Border Height="1"
                                    Margin="0,4"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!-- 命令行用系统按钮的悬停态，整行可点；不做并排等宽按钮 -->
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="12,8"
                                    Click="OnShareCopyClick">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="12">
                                    <FontIcon FontSize="16"
                                              Glyph="&#xE8C8;"
                                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="复制链接"
                                               Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                            </Button>
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="12,8"
                                    Click="OnShareSystemClick">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="12">
                                    <FontIcon FontSize="16"
                                              Glyph="&#xE72D;"
                                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="系统分享…"
                                               Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <StackPanel>
                    <FontIcon FontSize="28" Glyph="&#xE72D;" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                    <TextBlock x:Name="RepostCount" Text="0" FontSize="11" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- 一句话提示（加入稍后再看的结果、小窗切换）：2.5 秒后自己消失，不吃鼠标 -->
        <Border x:Name="StageToast"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,0,0,120"
                Padding="14,8"
                CornerRadius="6"
                Background="#CC1A1A1A"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock x:Name="StageToastText"
                       Foreground="#FFFFFFFF"
                       FontSize="13"
                       TextWrapping="Wrap"
                       MaxWidth="520" />
        </Border>

        <!-- 错误提示 -->
        <TextBlock x:Name="StageError"
                   Foreground="#FFFFFFFF"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
                </Grid>
            </SplitView.Content>
        </SplitView>

        <!-- 评论图片的大图：点评论里的图/表情包打开，点任意处或右上 × 关掉。
             盖在整个舞台之上（含评论面板），不开新窗口。 -->
        <Grid x:Name="CommentImageViewer"
              Background="#E6000000"
              Visibility="Collapsed"
              Tapped="OnCommentImageViewerTapped">
            <Image x:Name="CommentImageViewerImage"
                   Stretch="Uniform"
                   Margin="32,32,32,56" />
            <Button Style="{StaticResource PanelBtnStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="16"
                    ToolTipService.ToolTip="关闭"
                    Click="OnCommentImageViewerCloseClick">
                <FontIcon FontSize="16" Glyph="&#xE711;" Foreground="#FFFFFFFF" />
            </Button>
        </Grid>

        <!-- 视频信息：系统 ContentDialog 默认样式（遮罩、卡片、按钮排布都交给系统），内容按 WinUI 3 属性行排版。
             值由 OnContextVideoInfoClick 在弹出前填好；正文可选中复制。 -->
        <ContentDialog x:Name="VideoInfoDialog"
                       Title="视频信息"
                       PrimaryButtonText="复制链接"
                       SecondaryButtonText="复制视频 ID"
                       CloseButtonText="关闭"
                       DefaultButton="Close">
            <ScrollViewer MaxHeight="420"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid MinWidth="360"
                      RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="标题"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Top" />
                    <TextBlock x:Name="InfoTitleText"
                               Grid.Row="0"
                               Grid.Column="1"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />

                    <TextBlock Grid.Row="1"
                               Text="作者"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Top" />
                    <TextBlock x:Name="InfoAuthorText"
                               Grid.Row="1"
                               Grid.Column="1"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               Tapped="OnInfoAuthorTapped"
                               ToolTipService.ToolTip="打开作者主页" />

                    <TextBlock Grid.Row="2"
                               Text="视频 ID"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Top" />
                    <TextBlock x:Name="InfoIdText"
                               Grid.Row="2"
                               Grid.Column="1"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />

                    <TextBlock Grid.Row="3"
                               Text="画面"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Top" />
                    <TextBlock x:Name="InfoFrameText"
                               Grid.Row="3"
                               Grid.Column="1"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />

                    <TextBlock Grid.Row="4"
                               Text="时长"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Top" />
                    <TextBlock x:Name="InfoDurationText"
                               Grid.Row="4"
                               Grid.Column="1"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />

                    <TextBlock Grid.Row="5"
                               Text="清晰度"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Top" />
                    <TextBlock x:Name="InfoQualityText"
                               Grid.Row="5"
                               Grid.Column="1"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />

                    <TextBlock Grid.Row="6"
                               Text="发布时间"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Top" />
                    <TextBlock x:Name="InfoTimeText"
                               Grid.Row="6"
                               Grid.Column="1"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />

                    <TextBlock Grid.Row="7"
                               Text="数据"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Top" />
                    <TextBlock x:Name="InfoStatsText"
                               Grid.Row="7"
                               Grid.Column="1"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />

                    <TextBlock Grid.Row="8"
                               Text="链接"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Top" />
                    <TextBlock x:Name="InfoLinkText"
                               Grid.Row="8"
                               Grid.Column="1"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </Grid>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</UserControl>
