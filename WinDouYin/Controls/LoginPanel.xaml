<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinDouYin.Controls.LoginPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinDouYin.Controls"
    xmlns:conv="using:WinDouYin.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- 居中面板与"我的"站共用这一块。登录框本体是官方的（见 LoginWebView），这里只加一句状态话。
         宽度不写死：登录框按 726:483 的比例由宿主给预算（LoginPanel.FitTo），472 那个临时值撤掉 -->
    <StackPanel Spacing="10">
        <TextBlock x:Uid="LoginPanel_Title"
                   HorizontalAlignment="Center" />
        <!-- 内核只在真正要登录时才建：启动路径上绝不能碰 WebView2 -->
        <Grid x:Name="WebHost"
              HorizontalAlignment="Center" />
        <TextBlock x:Name="Status"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <Button x:Uid="LoginPanel_Reload"
                HorizontalAlignment="Center"
                Click="OnReload" />
        <!-- 登进来的是哪个号由官方说了算，所以必须留一条"换号"的路：清罐子 + 清登录框 profile -->
        <Button x:Uid="LoginPanel_SignOut"
                HorizontalAlignment="Center"
                Visibility="{x:Bind ViewModel.LoginVM.IsLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Click="OnSignOut" />
    </StackPanel>
</UserControl>
