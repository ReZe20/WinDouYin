<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinDouYin.Controls.AccountBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinDouYin.Controls"
    xmlns:conv="using:WinDouYin.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinDouYin.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- Button 默认 MinWidth=40/MinHeight=32 会把方格子撑成椭圆，所以显式归零；
         空隙靠缩小字形得到，圆框本身不放大。
         点格子弹账号菜单（Flyout）：头部亮"登的是谁"，按钮按登录态现算（开时 SyncMenuState） -->
    <Button x:Name="AvatarButton"
            Width="34"
            Height="34"
            MinWidth="0"
            MinHeight="0"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            ToolTipService.ToolTip="{x:Bind AccountTip}">
        <Button.Flyout>
            <Flyout x:Name="AccountFlyout"
                    Placement="BottomEdgeAlignedRight"
                    ShouldConstrainToRootBounds="True">
                <StackPanel MinWidth="256"
                            MaxWidth="332"
                            Spacing="4">
                    <Grid x:Name="FlyoutHeader"
                          ColumnSpacing="10"
                          Margin="4,4,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="28"
                                 Height="28">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{x:Bind ViewModel.LoginVM.Avatar, Mode=OneWay}"
                                            Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{x:Bind ViewModel.LoginVM.Nickname, Mode=OneWay}" />
                    </Grid>

                    <!-- 这台机器上登过的号：点谁就切谁，当前那颗带勾。多账号的正门就在这排，
                         不再逼用户"先退出才能登下一个"。 -->
                    <ScrollViewer x:Name="AccountListHost"
                                  MaxHeight="252"
                                  Margin="-4,0,-4,0"
                                  Visibility="{x:Bind ViewModel.LoginVM.AccountsVisibility, Mode=OneWay}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.LoginVM.Accounts, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccountRowViewModel">
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Tag="{x:Bind Uid}"
                                            ToolTipService.ToolTip="{x:Bind AvatarTip}"
                                            Click="OnAccountRowClick">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="24"
                                                  Height="24">
                                                <Ellipse Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                                         StrokeThickness="1"
                                                         Visibility="{x:Bind HasGlyph, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                <FontIcon FontSize="9"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Glyph="&#xE710;"
                                                          Visibility="{x:Bind HasGlyph, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                <Ellipse Visibility="{x:Bind HasAvatar, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{x:Bind Avatar, Mode=OneWay}"
                                                                    Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{x:Bind Nickname}" />
                                            <FontIcon Grid.Column="2"
                                                      VerticalAlignment="Center"
                                                      FontSize="12"
                                                      Glyph="&#xE73E;"
                                                      Visibility="{x:Bind CurrentMarkVisibility}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Height="1"
                            Margin="4,2"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Button x:Name="FlyoutMessages"
                            x:Uid="AccountFlyout_Messages"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="OnFlyoutMessages" />
                    <Button x:Name="FlyoutLogin"
                            x:Uid="AccountFlyout_Login"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="OnFlyoutLogin" />
                    <Button x:Name="FlyoutAddAccount"
                            x:Uid="AccountFlyout_Add"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="OnFlyoutAddAccount" />
                    <Button x:Name="FlyoutSignOut"
                            x:Uid="AccountFlyout_SignOut"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="OnFlyoutSignOut" />

                    <TextBlock x:Name="AccountMessage"
                               Margin="8,2,8,4"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.LoginVM.AccountMessageVisibility, Mode=OneWay}"
                               Text="{x:Bind ViewModel.LoginVM.AccountMessage, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
            </Flyout>
        </Button.Flyout>
        <Grid Width="34"
              Height="34">
            <Ellipse Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                     StrokeThickness="1"
                     Visibility="{x:Bind ViewModel.LoginVM.IsGlyphVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <FontIcon FontSize="11"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Glyph="&#xE710;"
                      Visibility="{x:Bind ViewModel.LoginVM.IsGlyphVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <Ellipse Visibility="{x:Bind ViewModel.LoginVM.IsAvatarVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="{x:Bind ViewModel.LoginVM.Avatar, Mode=OneWay}"
                                Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>
        </Grid>
    </Button>
</UserControl>
