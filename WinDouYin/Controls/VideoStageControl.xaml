<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinDouYin.Controls.VideoStageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinDouYin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 面板内按钮：无背景，纯图标 -->
        <Style x:Key="PanelBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <!-- WinUI3 Fluent 设置卡片：圆角 + 卡片底色 + 描边，用于弹幕设置 Flyout 内每一项 -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12,16,12" />
        </Style>
    </UserControl.Resources>

    <!-- Background 用 Transparent 而非 null：视觉上不铺黑底，但保证空白区域仍能命中测试，鼠标移动才能唤出底部面板 -->
    <Grid x:Name="Root" Background="Transparent">
        <!-- 双通道视频层 -->
        <Grid x:Name="LayerA">
            <Grid.RenderTransform>
                <TranslateTransform />
            </Grid.RenderTransform>
            <Image x:Name="CoverA" Stretch="UniformToFill" />
            <!-- 视频元素缩到画面实际尺寸（代码按 NaturalVideo 设 Width/Height），居中摆放，四周露出 Cover 模糊板 -->
            <Grid Margin="0,0,60,0">
                <MediaPlayerElement x:Name="PlayerA"
                                    Stretch="Uniform"
                                    Background="Transparent"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <Grid x:Name="LayerB" Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform />
            </Grid.RenderTransform>
            <Image x:Name="CoverB" Stretch="UniformToFill" />
            <Grid Margin="0,0,60,0">
                <MediaPlayerElement x:Name="PlayerB"
                                    Stretch="Uniform"
                                    Background="Transparent"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <!-- 信息区：不参与浮动面板显隐，常驻；但有自己的位移变换，面板上浮时跟着一起上浮（见 ShowPanel/TryHidePanel） -->
        <controls:VideoInfoControl x:Name="Info">
            <controls:VideoInfoControl.RenderTransform>
                <TranslateTransform x:Name="InfoTransform" />
            </controls:VideoInfoControl.RenderTransform>
        </controls:VideoInfoControl>

        <!-- 加载/缓冲提示：换台装载中或播放器 Buffering/Opening 时亮，播起来或出错即收 -->
        <ProgressRing x:Name="StageLoading"
                      Width="44"
                      Height="44"
                      Foreground="#FFFFFFFF"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="False"
                      Visibility="Collapsed" />

        <!-- ====== 底部浮动面板（两层） ======
             上层：进度条 Slider 跨满宽度
             下层：仿抖音官网——左侧 播放+时间+章节+弹幕区；右侧 连播+清屏+智能+倍速+设置+小窗+音量+全屏
             音量是点击图标弹出 Popup 里的滑块，不内联。 -->
        <Border x:Name="ControlPanel"
                VerticalAlignment="Bottom"
                Margin="16,0,16,16"
                Background="#B31A1A1A"
                CornerRadius="8"
                Padding="8,2,8,2">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PanelTransform" />
            </Border.RenderTransform>

            <StackPanel>
                <!-- 第一层：进度条独占 -->
                <Slider x:Name="ProgressSlider"
                        Minimum="0"
                        Maximum="1"
                        Value="0"
                        Margin="4,0,4,0" />

                <!-- 第二层：左右两组 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧组 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 播放/暂停 -->
                        <Button x:Name="PlayPauseButton"
                                Style="{StaticResource PanelBtnStyle}"
                                Click="OnPlayPauseClick">
                            <FontIcon x:Name="PlayPauseIcon"
                                      FontSize="16"
                                      Glyph="&#xE769;"
                                      Foreground="#FFFFFFFF" />
                        </Button>

                        <!-- 时间 -->
                        <TextBlock x:Name="TimeLabel"
                                   VerticalAlignment="Center"
                                   Margin="4,0,8,0"
                                   FontSize="12"
                                   Foreground="#CCFFFFFF"
                                   Text="00:00 / 00:00" />

                        <!-- 章节信息（抖音长视频有，短视频无数据时隐藏） -->
                        <TextBlock x:Name="ChapterLabel"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   FontSize="12"
                                   Foreground="#CCFFFFFF"
                                   Visibility="Collapsed" />

                        <!-- 弹幕开关 -->
                        <ToggleButton x:Name="DanmakuToggle"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="6,4"
                                      Foreground="#FFFFFFFF"
                                      Checked="OnDanmakuToggle"
                                      Unchecked="OnDanmakuToggle">
                            <TextBlock Text="弹" FontSize="14" />
                        </ToggleButton>

                        <!-- 弹幕输入：原始 TextBox，用原生 PlaceholderText 作说明文字，不覆盖任何样式 -->
                        <TextBox x:Name="DanmakuInput"
                                 VerticalAlignment="Center"
                                 Margin="4,0,0,0"
                                 Width="160"
                                 PlaceholderText="发一条友好的弹幕吧" />

                        <!-- 发送弹幕 -->
                        <Button x:Name="DanmakuSendButton"
                                Style="{StaticResource PanelBtnStyle}"
                                VerticalAlignment="Center"
                                Click="OnDanmakuSend">
                            <TextBlock Text="发送" FontSize="12" Foreground="#FE2C55" />
                        </Button>

                        <!-- 弹幕设置：点击弹出 Flyout -->
                        <Button x:Name="DanmakuSettingsButton"
                                Style="{StaticResource PanelBtnStyle}"
                                VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE115;" Foreground="#CCFFFFFF" />
                            <Button.Flyout>
                                <Flyout x:Name="DanmakuSettingsFlyout" Placement="Top">
                                    <StackPanel Width="320" Spacing="6">
                                        <!-- 标题行：左标题 + 右恢复默认 -->
                                        <Grid Margin="2,0,2,8">
                                            <TextBlock Text="弹幕设置" Style="{ThemeResource TitleTextBlockStyle}" FontSize="18" VerticalAlignment="Center" />
                                            <Button x:Name="DanmakuResetButton"
                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                    HorizontalAlignment="Right"
                                                    Click="OnDanmakuReset">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                                    <TextBlock Text="恢复默认" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- 不透明度：标题+值在上，滑块在下 -->
                                        <Border Style="{StaticResource SettingsCardStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="不透明度" Style="{ThemeResource BodyTextBlockStyle}" />
                                                    <TextBlock x:Name="DanmakuOpacityText"
                                                               Text="80%"
                                                               Style="{ThemeResource BodyTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                                <Slider x:Name="DanmakuOpacitySlider"
                                                        Margin="0,8,0,0"
                                                        Minimum="0"
                                                        Maximum="100"
                                                        Value="80"
                                                        ValueChanged="OnDanmakuOpacityChanged" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 显示区域 -->
                                        <Border Style="{StaticResource SettingsCardStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="显示区域" Style="{ThemeResource BodyTextBlockStyle}" />
                                                    <TextBlock x:Name="DanmakuAreaText"
                                                               Text="两行"
                                                               Style="{ThemeResource BodyTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                                <Slider x:Name="DanmakuAreaSlider"
                                                        Margin="0,8,0,0"
                                                        Minimum="0"
                                                        Maximum="2"
                                                        Value="1"
                                                        TickFrequency="1"
                                                        SnapsTo="Ticks"
                                                        ValueChanged="OnDanmakuAreaChanged" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 字体大小 -->
                                        <Border Style="{StaticResource SettingsCardStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="字体大小" Style="{ThemeResource BodyTextBlockStyle}" />
                                                    <TextBlock x:Name="DanmakuFontText"
                                                               Text="适中"
                                                               Style="{ThemeResource BodyTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                                <Slider x:Name="DanmakuFontSlider"
                                                        Margin="0,8,0,0"
                                                        Minimum="0"
                                                        Maximum="2"
                                                        Value="1"
                                                        TickFrequency="1"
                                                        SnapsTo="Ticks"
                                                        ValueChanged="OnDanmakuFontChanged" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 移动速度 -->
                                        <Border Style="{StaticResource SettingsCardStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="移动速度" Style="{ThemeResource BodyTextBlockStyle}" />
                                                    <TextBlock x:Name="DanmakuSpeedText"
                                                               Text="适中"
                                                               Style="{ThemeResource BodyTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                                <Slider x:Name="DanmakuSpeedSlider"
                                                        Margin="0,8,0,0"
                                                        Minimum="0"
                                                        Maximum="2"
                                                        Value="1"
                                                        TickFrequency="1"
                                                        SnapsTo="Ticks"
                                                        ValueChanged="OnDanmakuSpeedChanged" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 弹幕列表：整行可点，右箭头 -->
                                        <Button x:Name="DanmakuListButton"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnDanmakuList">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <Grid>
                                                    <TextBlock Text="弹幕列表" Style="{ThemeResource BodyTextBlockStyle}" />
                                                    <FontIcon FontSize="14"
                                                              Glyph="&#xE76C;"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- 右侧组 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 连播 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                            <ToggleSwitch x:Name="AutoPlayToggle"
                                          OnContent="" OffContent=""
                                          MinWidth="0"
                                          Toggled="OnAutoPlayToggled" />
                            <TextBlock Text="连播" FontSize="12" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 清屏 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                            <ToggleSwitch x:Name="ClearScreenToggle"
                                          OnContent="" OffContent=""
                                          MinWidth="0"
                                          Toggled="OnClearScreenToggled" />
                            <TextBlock Text="清屏" FontSize="12" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 智能 -->
                        <Button x:Name="SmartButton" Style="{StaticResource PanelBtnStyle}" Click="OnSmartClick">
                            <TextBlock Text="智能" FontSize="12" Foreground="#CCFFFFFF" />
                        </Button>

                        <!-- 倍速：点击循环 0.75/1/1.25/1.5/2，按钮文字跟着显示当前档 -->
                        <Button x:Name="SpeedButton" Style="{StaticResource PanelBtnStyle}" Click="OnSpeedClick">
                            <TextBlock x:Name="SpeedLabel" Text="倍速" FontSize="12" Foreground="#CCFFFFFF" />
                        </Button>

                        <!-- 设置 -->
                        <Button x:Name="SettingsButton" Style="{StaticResource PanelBtnStyle}" Click="OnSettingsClick">
                            <FontIcon FontSize="16" Glyph="&#xE713;" Foreground="#CCFFFFFF" />
                        </Button>

                        <!-- 小窗 -->
                        <Button x:Name="PipButton" Style="{StaticResource PanelBtnStyle}" Click="OnPipClick">
                            <FontIcon FontSize="16" Glyph="&#xE8B9;" Foreground="#CCFFFFFF" />
                        </Button>

                        <!-- 音量：点击弹出滑块 -->
                        <Button x:Name="VolumeButton" Style="{StaticResource PanelBtnStyle}">
                            <FontIcon x:Name="VolumeIcon"
                                      FontSize="16"
                                      Glyph="&#xE767;"
                                      Foreground="#CCFFFFFF" />
                            <Button.Flyout>
                                <Flyout x:Name="VolumeFlyout" Placement="Top">
                                    <StackPanel Width="32" HorizontalAlignment="Center">
                                        <Slider x:Name="VolumeSlider"
                                                Orientation="Vertical"
                                                Height="100"
                                                Minimum="0"
                                                Maximum="100"
                                                SmallChange="1"
                                                LargeChange="10"
                                                Value="100"
                                                HorizontalAlignment="Center"
                                                ValueChanged="OnVolumeChanged" />
                                        <TextBlock x:Name="VolumeText"
                                                   Text="100%"
                                                   FontSize="11"
                                                   Foreground="#FFFFFFFF"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- 全屏 -->
                        <Button x:Name="FullscreenButton" Style="{StaticResource PanelBtnStyle}" Click="OnFullscreenClick">
                            <FontIcon FontSize="16" Glyph="&#xE740;" Foreground="#CCFFFFFF" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 右侧竖排交互列：作者头像 + 点赞 + 评论 + 收藏 + 转发，落在视频预留的 60px 右边距里 -->
        <StackPanel x:Name="RightRail"
                    Width="60"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,90"
                    Spacing="20">
            <!-- 作者头像 -->
            <Button x:Name="AuthorAvatarButton"
                    Style="{StaticResource PanelBtnStyle}"
                    HorizontalAlignment="Center"
                    Click="OnAuthorClick">
                <Ellipse x:Name="AuthorAvatar" Width="40" Height="40">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="AuthorAvatarBrush" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </Button>

            <!-- 点赞 -->
            <Button x:Name="LikeButton"
                    Style="{StaticResource PanelBtnStyle}"
                    HorizontalAlignment="Center"
                    Click="OnLikeClick">
                <StackPanel>
                    <FontIcon FontSize="28" Glyph="&#xEB51;" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                    <TextBlock x:Name="LikeCount" Text="0" FontSize="11" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- 评论 -->
            <Button x:Name="CommentButton"
                    Style="{StaticResource PanelBtnStyle}"
                    HorizontalAlignment="Center"
                    Click="OnCommentClick">
                <StackPanel>
                    <FontIcon FontSize="28" Glyph="&#xE8BD;" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CommentCount" Text="0" FontSize="11" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- 收藏 -->
            <Button x:Name="FavoriteButton"
                    Style="{StaticResource PanelBtnStyle}"
                    HorizontalAlignment="Center"
                    Click="OnFavoriteClick">
                <StackPanel>
                    <FontIcon FontSize="28" Glyph="&#xE734;" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                    <TextBlock x:Name="FavoriteCount" Text="0" FontSize="11" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- 转发 -->
            <Button x:Name="RepostButton"
                    Style="{StaticResource PanelBtnStyle}"
                    HorizontalAlignment="Center"
                    Click="OnRepostClick">
                <StackPanel>
                    <FontIcon FontSize="28" Glyph="&#xE72D;" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                    <TextBlock x:Name="RepostCount" Text="0" FontSize="11" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- 错误提示 -->
        <TextBlock x:Name="StageError"
                   Foreground="#FFFFFFFF"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
