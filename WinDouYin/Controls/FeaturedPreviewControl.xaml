<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinDouYin.Controls.FeaturedPreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 网格里的静音预览：画面 + 底部渐隐 + 时间 + 2px 进度条。
         没有播放器控件条（官方悬停态那排按钮在这里会抢走指针、把预览打断），
         点卡片进播放页看正片——预览只负责"这卡是活的"。 -->
    <Grid Background="Transparent">
        <MediaPlayerElement x:Name="Video"
                            AreTransportControlsEnabled="False"
                            Stretch="UniformToFill" />

        <Border Height="56"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#00000000" />
                    <GradientStop Offset="1" Color="#8C000000" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <TextBlock x:Name="TimeText"
                   Margin="10,0,0,10"
                   VerticalAlignment="Bottom"
                   FontSize="12"
                   Foreground="White"
                   IsHitTestVisible="False" />

        <ProgressBar x:Name="Bar"
                     Height="2"
                     Margin="0,0,0,0"
                     VerticalAlignment="Bottom"
                     Minimum="0"
                     Maximum="1"
                     IsHitTestVisible="False"
                     Background="#33FFFFFF"
                     Foreground="White" />
    </Grid>
</UserControl>
