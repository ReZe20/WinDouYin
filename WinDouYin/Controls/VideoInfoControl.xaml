<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinDouYin.Controls.VideoInfoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 官方网页 d36606e4 实测（125% DPI 换算成 DIP）：
         文字左缘距画面左缘 16；正文折行宽约 300。
         作者行：名 18 纯白 SemiBold，图文帖在名右侧带“图文”胶囊，"·"与时间 12 九成白；正文 14、行高 22.4；话题黄 #FACE15 SemiBold（行内）。
         名字放不下时在代码里截成"前缀…"，右侧"· 时间"整段永远完整。
         底边距取 16（与底部面板的 16 底边距同一档）：面板收起时标题沉到底，
         面板上浮时由 VideoStageControl.InfoLift 把整块抬到面板顶缘之上，所以这里不再预留控条高度。
         图文切换按钮是这块里唯一的可点元素；其余文本不吃指针，滚轮照常冒泡给换台。 -->
    <Grid Margin="16,0,16,16"
          HorizontalAlignment="Left"
          VerticalAlignment="Bottom">
        <StackPanel MaxWidth="300">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="AuthorLine"
                           FontFamily="Microsoft YaHei"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="NoWrap"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center" />
                <!-- 图文/动图的身份提示：放在作者名右侧，走 WinUI 的圆角/内边距与字幕字号。 -->
                <Border x:Name="ImagePostBadge"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Margin="8,0,0,0"
                        Padding="6,1,6,2"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Background="#26FFFFFF"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="图文"
                               FontFamily="Microsoft YaHei"
                               FontSize="11"
                               LineHeight="14"
                               Foreground="#E6FFFFFF" />
                </Border>
                <!-- 图文切换：贴在"图文"标识右边。 -->
                <StackPanel x:Name="ImageNav"
                            Visibility="Collapsed"
                            Orientation="Horizontal"
                            Spacing="2"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center">
                    <Button x:Name="ImagePrevButton"
                            Click="OnImagePrevClick"
                            Width="22"
                            Height="22"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            CornerRadius="4"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="上一张">
                        <FontIcon Glyph="&#xE76B;" FontSize="10" Foreground="#CCFFFFFF" />
                    </Button>
                    <Button x:Name="ImageNextButton"
                            Click="OnImageNextClick"
                            Width="22"
                            Height="22"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            CornerRadius="4"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="下一张">
                        <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="#CCFFFFFF" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="TimeLine"
                           FontFamily="Microsoft YaHei"
                           FontSize="12"
                           TextWrapping="NoWrap"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center" />
            </StackPanel>
            <!-- 朋友推荐：只在 level=1 的朋友推荐流里出现，空串收起；格式「朋友 刘鼎业 推荐」。 -->
            <TextBlock x:Name="FriendLine"
                       Visibility="Collapsed"
                       FontFamily="Microsoft YaHei"
                       FontSize="12"
                       LineHeight="16.8"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap"
                       IsHitTestVisible="False" />
            <TextBlock x:Name="DescBlock"
                       FontFamily="Microsoft YaHei"
                       FontSize="14"
                       LineHeight="22.4"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       IsHitTestVisible="False" />
        </StackPanel>
    </Grid>
</UserControl>
