<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinDouYin.Controls.MessagesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinDouYin.Controls"
    xmlns:vm="using:WinDouYin.ViewModels"
    Width="380">

    <UserControl.Resources>
        <!-- 分享卡：整张卡是一个按钮，点卡开视频。卡片样式收发共用；
             左右位置由会话行里的 HorizontalAlignment 绑各自一侧。 -->
        <Style x:Key="ChatCardStyle"
               TargetType="Button"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        </Style>

        <!-- 引用块：就一颗 Subtle 按钮（悬停/按下/焦点框都交系统），不加自造底色与内边距。 -->
        <Style x:Key="ChatQuoteStyle"
               TargetType="Button"
               BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MaxWidth" Value="240" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        </Style>

        <!-- 正文卡片：系统卡底 + 1px 描边 + 圆角，把文字与引用框在一起，贴在发言者那一侧。 -->
        <Style x:Key="ChatBodyCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MaxWidth" Value="260" />
        </Style>

        <!-- 会话行：没有彩色气泡；对方在左、自己在右。头像与名字只在一次连续发言的第一条出现，
             自己的名字走系统 Accent；文字与引用一起装进系统卡片，时间统一一行放在消息下面。 -->
        <DataTemplate x:Key="ChatMessageTemplate" x:DataType="vm:ChatMessageRow">
            <Grid Padding="0,4"
                  ColumnSpacing="12">
                <!-- 这行不吃高亮动画：点引用跳转的那层底与它的时间线在 ChatList 的 ItemContainerStyle 里
                     （只有列表项容器是 Control，才切得动 VisualState）。 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <PersonPicture Grid.Column="0"
                               Width="32"
                               Height="32"
                               VerticalAlignment="Top"
                               Visibility="{x:Bind PeerAvatarVisibility}"
                               ProfilePicture="{x:Bind Avatar}"
                               Initials="{x:Bind AvatarInitials}" />
                <StackPanel Grid.Column="1"
                            Spacing="4">
                    <!-- 发言头只出名字（时间统一挪到消息下面）；连续同一人的后续消息两侧都收起。 -->
                    <TextBlock Text="{x:Bind SenderName}"
                               Visibility="{x:Bind PeerNameVisibility}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind SenderName}"
                               HorizontalAlignment="Right"
                               Visibility="{x:Bind MineHeaderVisibility}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <Image Visibility="{x:Bind StickerVisibility}"
                           Source="{x:Bind StickerImage}"
                           MaxWidth="140"
                           MaxHeight="140"
                           HorizontalAlignment="{x:Bind AttachmentAlign}"
                           Stretch="Uniform" />
                    <Border Visibility="{x:Bind PhotoVisibility}"
                            HorizontalAlignment="{x:Bind AttachmentAlign}"
                            Padding="2"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <Border CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Image Source="{x:Bind PhotoImage}"
                                   MaxWidth="232"
                                   MaxHeight="300"
                                   Stretch="Uniform" />
                        </Border>
                    </Border>
                    <Button Visibility="{x:Bind ShareVisibility}"
                            Style="{StaticResource ChatCardStyle}"
                            HorizontalAlignment="{x:Bind AttachmentAlign}"
                            MaxWidth="240"
                            Tag="{x:Bind ShareVideoId}"
                            Click="OnShareClick">
                        <StackPanel Spacing="8">
                            <!-- 105 评论分享卡：评论原文在上，与下方视频卡片之间用分割线隔开。 -->
                            <StackPanel Visibility="{x:Bind ReviewVisibility}"
                                        Spacing="6">
                                <TextBlock Text="{x:Bind ReviewAuthor}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ReviewText}"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <ItemsControl ItemsSource="{x:Bind ReviewImages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ImageSource">
                                            <Border CornerRadius="{ThemeResource ControlCornerRadius}">
                                                <Image Source="{Binding}"
                                                       MaxWidth="100"
                                                       MaxHeight="100"
                                                       Stretch="Uniform" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{x:Bind ReviewStickers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ImageSource">
                                            <Image Source="{Binding}"
                                                   MaxWidth="80"
                                                   MaxHeight="80"
                                                   Stretch="Uniform" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Border Height="1"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Visibility="{x:Bind ReviewVisibility}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ShareTitle}"
                                               MaxLines="2"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind ShareSubtitle}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Width="56"
                                        Height="56"
                                        VerticalAlignment="Center"
                                        CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <Image Source="{x:Bind ShareCover}"
                                           Stretch="UniformToFill" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Button>
                    <!-- 正文与引用一起装进系统卡片（卡底 + 1px 描边 + 圆角），贴在各自一侧；
                         卡片宽随内容、上限 260，文字一律左对齐才好读。 -->
                    <Border Style="{StaticResource ChatBodyCardStyle}"
                            HorizontalAlignment="{x:Bind AttachmentAlign}"
                            Visibility="{x:Bind BodyCardVisibility}">
                        <StackPanel Spacing="6">
                            <RichTextBlock controls:EmojiText.Text="{x:Bind Text}"
                                           Visibility="{x:Bind TextVisibility}"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           FontSize="14"
                                           LineHeight="20"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <!-- 引用回复：整块是一颗系统 Subtle 按钮，点一下跳到被回复那条
                                 （找不到时由 ViewModel 在发送状态那行说明）；块内是 2px 灰条 + 「昵称：摘要」。 -->
                            <Button Style="{StaticResource ChatQuoteStyle}"
                                    HorizontalAlignment="Left"
                                    Visibility="{x:Bind QuoteVisibility}"
                                    Tag="{x:Bind}"
                                    Click="OnQuoteClick"
                                    AutomationProperties.Name="跳转到被回复的消息"
                                    ToolTipService.ToolTip="{x:Bind QuoteText}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource TextFillColorTertiaryBrush}"
                                            CornerRadius="1" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind QuoteText}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis"
                                               TextAlignment="Left"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                    <!-- 时间统一一行放在消息下面，跟着自己/对方贴边。 -->
                    <TextBlock Text="{x:Bind TimeText}"
                               Visibility="{x:Bind TimeVisibility}"
                               HorizontalAlignment="{x:Bind AttachmentAlign}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <PersonPicture Grid.Column="2"
                               Width="32"
                               Height="32"
                               VerticalAlignment="Top"
                               Visibility="{x:Bind MineAvatarVisibility}"
                               ProfilePicture="{x:Bind Avatar}"
                               Initials="{x:Bind AvatarInitials}" />
            </Grid>
        </DataTemplate>

        <!-- 系统提示（连火花、打招呼之类的 tips）：居中一行灰字。 -->
        <DataTemplate x:Key="SystemChatTemplate" x:DataType="vm:ChatMessageRow">
            <TextBlock Text="{x:Bind Text}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="300"
                       Margin="16,10"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </DataTemplate>

        <controls:ChatTemplateSelector x:Key="ChatTemplateSelector"
                                       MessageTemplate="{StaticResource ChatMessageTemplate}"
                                       SystemTemplate="{StaticResource SystemChatTemplate}" />
    </UserControl.Resources>

    <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
        <Grid>
            <!-- 会话列表 -->
            <Grid Padding="16,12,16,12"
                  RowSpacing="10"
                  Visibility="{x:Bind Messages.ListVisibility, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="消息"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            ToolTipService.ToolTip="收起消息"
                            Click="OnPanelCloseClick">
                        <FontIcon FontSize="14"
                                  Glyph="&#xE711;"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <ListView x:Name="ConversationList"
                              ItemsSource="{x:Bind Messages.Rows}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="OnConversationClick"
                              Padding="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MessageRow">
                                <Grid Padding="4,10"
                                      ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <PersonPicture Width="40"
                                                   Height="40"
                                                   ProfilePicture="{x:Bind Avatar}"
                                                   Initials="{x:Bind Initials}" />
                                    <StackPanel Grid.Column="1"
                                                Spacing="4"
                                                VerticalAlignment="Center">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Title}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind TimeText}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Preview}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Visibility="{x:Bind Messages.LoadingVisibility, Mode=OneWay}">
                        <ProgressRing Width="28"
                                      Height="28"
                                      IsActive="True" />
                        <TextBlock Text="正在读取消息…"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               MaxWidth="280"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind Messages.Status, Mode=OneWay}"
                               Visibility="{x:Bind Messages.StatusVisibility, Mode=OneWay}" />
                </Grid>
            </Grid>

            <!-- 聊天窗 -->
            <Grid Visibility="{x:Bind Messages.ChatVisibility, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 页头 48 高：返回 / 头像 / 标题 / 收起。图标钮走 SubtleButtonStyle，
                     悬停、按下、焦点框都交回系统视觉状态。 -->
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Height="48"
                          Padding="12,0"
                          ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                AutomationProperties.Name="返回消息列表"
                                ToolTipService.ToolTip="返回消息列表"
                                Click="OnChatBackClick">
                            <FontIcon FontSize="14"
                                      Glyph="&#xE72B;" />
                        </Button>
                        <PersonPicture Grid.Column="1"
                                       Width="28"
                                       Height="28"
                                       VerticalAlignment="Center"
                                       ProfilePicture="{x:Bind Messages.ChatAvatar, Mode=OneWay}"
                                       Initials="{x:Bind Messages.ChatInitials, Mode=OneWay}" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind Messages.ChatTitle, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="3"
                                Style="{StaticResource SubtleButtonStyle}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                AutomationProperties.Name="收起消息"
                                ToolTipService.ToolTip="收起消息"
                                Click="OnPanelCloseClick">
                            <FontIcon FontSize="14"
                                      Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                </Border>

                <Button Grid.Row="1"
                        Content="查看更早的消息"
                        Style="{StaticResource SubtleButtonStyle}"
                        FontSize="12"
                        HorizontalAlignment="Center"
                        Margin="0,2,0,6"
                        Padding="12,4"
                        Click="OnOlderClick"
                        Visibility="{x:Bind Messages.OlderVisibility, Mode=OneWay}" />

                <Grid Grid.Row="2">
                    <ListView x:Name="ChatList"
                              ItemsSource="{x:Bind Messages.ChatRows}"
                              ItemTemplateSelector="{StaticResource ChatTemplateSelector}"
                              SelectionMode="None"
                              Padding="12,2,12,8">
                        <!-- 会话行不可点、也不出悬停/按下底色：这两档底色原本靠把 ListViewItemBackgroundPointerOver/Pressed
                             收成 Transparent 得来，现在模板里没有那面会读它们的 ListViewItemPresenter（见下面的 ItemContainerStyle），
                             这两枚覆盖成了死键，一并撤掉。选中态本来就不会出现（SelectionMode=None）。 -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="IsTabStop" Value="False" />
                                <!-- 引用跳转的落点高亮整个放在这层模板里，code-behind 只对容器递一句
                                     GoToState(item, "Flashed")。为什么不放在会话行的模板里——WinUI 3 只有
                                     GoToState(Control,…)（包内 metadata 实测没有 UWP 那个 GoToElementState），
                                     会话行的根是 Grid，切不动状态；ListViewItem 本身是 Control。
                                     模板根从系统的 ListViewItemPresenter 换成普通 Grid：那层控件管的就是
                                     悬停/按下/选中底色与勾选框，而这一列 SelectionMode=None、悬停与按下
                                     底色早先就被收成了 Transparent，照搬不过来等于没丢视觉。
                                     写法照 generic.xaml 里官方那两面换过模板的 ListViewItem（选择器浮层、
                                     RadioButtons 条目）：ContentPresenter 显式绑 Content/ContentTemplate。 -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Grid>
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="ChatFlashStates">
                                                        <VisualState x:Name="Normal" />
                                                        <VisualState x:Name="Flashed">
                                                            <!-- 淡入 180ms → 停 1.1s → 淡出 700ms。四拍必须打在
                                                                 同一条关键帧动画上：同一个 Storyboard 里两条动画
                                                                 指同一个元素的同一个属性，Begin() 会被 XAML 直接拒掉
                                                                 （实测 COMException 0x800F1000）。 -->
                                                            <Storyboard>
                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FlashLayer"
                                                                                               Storyboard.TargetProperty="Opacity"
                                                                                               Duration="0:0:1.980">
                                                                    <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0" />
                                                                    <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.180" />
                                                                    <LinearDoubleKeyFrame Value="1" KeyTime="0:0:1.280" />
                                                                    <LinearDoubleKeyFrame Value="0" KeyTime="0:0:1.980" />
                                                                </DoubleAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <!-- 高亮层常驻但 Opacity=0（Collapsed 的元素不在视觉树里，切状态时找不到它）；
                                                     排在内容前面=垫在文字底下，不吃命中，文字照样能选中。
                                                     左右各出 4px、上下仍留 2px，跟会话行原来那层的取景一致。 -->
                                                <Border x:Name="FlashLayer"
                                                        Opacity="0"
                                                        Margin="-4,2"
                                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                        IsHitTestVisible="False" />
                                                <ContentPresenter x:Name="ContentPresenter"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Visibility="{x:Bind Messages.ChatLoadingVisibility, Mode=OneWay}">
                        <ProgressRing Width="28"
                                      Height="28"
                                      IsActive="True" />
                        <TextBlock Text="正在读取聊天记录…"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Visibility="{x:Bind Messages.ChatStatusVisibility, Mode=OneWay}">
                        <TextBlock MaxWidth="280"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind Messages.ChatStatus, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <!-- 发送栏与消息列表之间用系统分隔线隔开；输入框和命令钮分成两行，不再挤在同一层。 -->
                <Border Grid.Row="3"
                        Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid Grid.Row="4"
                      Padding="12,8,12,12"
                      RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 输入框交回系统 RichEditBox：卡底、描边、悬停与焦点态都用控件自带的；
                         高度不写死：随输入折行自动长高，到 MaxHeight 后内部滚动，清空后缩回一行；
                         表情仍是真图插进去，发送时由透明标签字符还原成码。 -->
                    <RichEditBox x:Name="ChatInput"
                                 MinHeight="40"
                                 MaxHeight="120"
                                 Padding="10,8,6,8"
                                 FontSize="14"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 PlaceholderText="发送消息"
                                 IsSpellCheckEnabled="False"
                                 IsTextPredictionEnabled="False"
                                 TextChanged="OnChatInputTextChanged"
                                 KeyDown="OnChatInputKeyDown">
                        <FlyoutBase.AttachedFlyout>
                            <!-- 表情面板走系统 Flyout：卡面、圆角、描边、阴影都由 FlyoutPresenter 出；
                                 Transient 让点外面收起，AllowFocusOnInteraction=False 让输入框不被抢焦点。
                                 内容只定宽高，不再套第二层卡。 -->
                            <Flyout x:Name="PickerFlyout"
                                    Placement="Top"
                                    ShowMode="Transient"
                                    AllowFocusOnInteraction="False"
                                    ShouldConstrainToRootBounds="True"
                                    Opened="OnPickerFlyoutOpened">
                                <Grid Width="320"
                                      Height="300"
                                      RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <SelectorBar x:Name="PickerTabs"
                                                 SelectionChanged="OnPickerTabChanged">
                                        <SelectorBarItem x:Name="EmojiTab" Text="表情" IsSelected="True" Tapped="OnPickerTabItemTapped" />
                                        <SelectorBarItem x:Name="StickerTab" Text="表情包" Tapped="OnPickerTabItemTapped" />
                                    </SelectorBar>
                                    <Grid Grid.Row="1">
                                        <ScrollViewer x:Name="EmojiPane"
                                                      VerticalScrollBarVisibility="Auto"
                                                      Padding="0,0,8,0">
                                            <StackPanel x:Name="EmojiHost" />
                                        </ScrollViewer>

                                        <Grid x:Name="StickerPane"
                                              Visibility="Collapsed"
                                              RowSpacing="4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <SelectorBar x:Name="StickerTabs"
                                                         SelectionChanged="OnStickerTabChanged">
                                                <SelectorBarItem x:Name="RecentStickerTab" Text="最近" Tapped="OnPickerTabItemTapped" />
                                                <SelectorBarItem x:Name="FavoriteStickerTab" Text="收藏" Tapped="OnPickerTabItemTapped" />
                                                <SelectorBarItem x:Name="TrendingStickerTab" Text="热门" IsSelected="True" Tapped="OnPickerTabItemTapped" />
                                                <SelectorBarItem x:Name="SearchStickerTab" Text="搜索" Tapped="OnPickerTabItemTapped" />
                                            </SelectorBar>

                                            <Grid x:Name="StickerSearchRow"
                                                  Grid.Row="1"
                                                  ColumnSpacing="6"
                                                  Visibility="{x:Bind Messages.StickerSearchVisibility, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="StickerSearchBox"
                                                         Height="32"
                                                         Padding="10,0"
                                                         FontSize="13"
                                                         PlaceholderText="搜表情包"
                                                         KeyDown="OnStickerSearchKeyDown" />
                                                <Button Grid.Column="1"
                                                        Content="搜索"
                                                        Height="32"
                                                        Padding="12,0"
                                                        Click="OnStickerSearchClick" />
                                            </Grid>

                                            <Grid Grid.Row="2">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              Padding="0,0,8,0">
                                                    <ItemsRepeater ItemsSource="{x:Bind Messages.StickerItems}">
                                                        <ItemsRepeater.Layout>
                                                            <UniformGridLayout MinItemWidth="72"
                                                                               MinItemHeight="82"
                                                                               MinRowSpacing="4"
                                                                               MinColumnSpacing="4"
                                                                               ItemsStretch="Fill"
                                                                               MaximumRowsOrColumns="4" />
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:StickerItem">
                                                                <Button Tag="{x:Bind Id}"
                                                                        Padding="2"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        HorizontalContentAlignment="Center"
                                                                        ToolTipService.ToolTip="{x:Bind DisplayName}"
                                                                        Click="OnStickerClick">
                                                                    <Button.ContextFlyout>
                                                                        <MenuFlyout>
                                                                            <MenuFlyoutItem Text="{x:Bind FavoriteText, Mode=OneWay}"
                                                                                            Tag="{x:Bind Id}"
                                                                                            Click="OnStickerFavoriteClick" />
                                                                        </MenuFlyout>
                                                                    </Button.ContextFlyout>
                                                                    <StackPanel Spacing="2"
                                                                                HorizontalAlignment="Center">
                                                                        <Image Source="{x:Bind Image}"
                                                                               Width="58"
                                                                               Height="58"
                                                                               Stretch="Uniform" />
                                                                        <TextBlock Text="{x:Bind DisplayName}"
                                                                                   FontSize="11"
                                                                                   MaxWidth="68"
                                                                                   HorizontalAlignment="Center"
                                                                                   TextAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </ScrollViewer>

                                                <ProgressRing Width="24"
                                                              Height="24"
                                                              IsActive="True"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Visibility="{x:Bind Messages.StickerLoadingVisibility, Mode=OneWay}" />

                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           MaxWidth="260"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           Text="{x:Bind Messages.StickerStatus, Mode=OneWay}"
                                                           Visibility="{x:Bind Messages.StickerStatusVisibility, Mode=OneWay}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>

                                            <Button Grid.Row="3"
                                                    Content="看更多"
                                                    HorizontalAlignment="Center"
                                                    Padding="10,2"
                                                    Click="OnStickerMoreClick"
                                                    Visibility="{x:Bind Messages.StickerMoreVisibility, Mode=OneWay}" />
                                        </Grid>

                                        <TextBlock x:Name="PickerStatus"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="260"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                </Grid>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </RichEditBox>

                    <!-- 命令行：表情在左；发送是主操作，用带文字的 Accent 按钮放在右。 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="EmojiButton"
                                Style="{StaticResource SubtleButtonStyle}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                AutomationProperties.Name="表情"
                                Click="OnEmojiClick"
                                ToolTipService.ToolTip="表情">
                            <FontIcon FontSize="16"
                                      Glyph="&#xE76E;" />
                        </Button>
                        <Button x:Name="SendButton"
                                Grid.Column="2"
                                Content="发送"
                                Style="{StaticResource AccentButtonStyle}"
                                Height="32"
                                Padding="16,0"
                                IsEnabled="False"
                                AutomationProperties.Name="发送"
                                ToolTipService.ToolTip="发送"
                                Click="OnSendClick" />
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="{x:Bind Messages.SendStatus, Mode=OneWay}"
                               Visibility="{x:Bind Messages.SendStatusVisibility, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
