<UserControl
    x:Class="WinDouYin.Controls.CollectFlyoutContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinDouYin.ViewModels">

    <!-- 收藏按钮悬浮出来的小面板：只列收藏夹与复选框，写入由宿主在面板关闭后统一做。
         全部走 WinUI 3 主题资源，和评论面板一致，不掺抖音红。 -->
    <Grid x:Name="Root"
          Width="260"
          Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="收藏到"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   Margin="0,0,0,8" />

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ListHost"
                          MaxHeight="320"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="FoldersList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CollectFolderRow">
                            <!-- 右侧留 14px 给浮层滚动条（WinUI 的纵向滚动条盖在内容上） -->
                            <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Margin="0,1,14,1"
                                      Checked="OnFolderChecked"
                                      Unchecked="OnFolderUnchecked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind CountText}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="StatusText"
                       Text="正在读取收藏夹…"
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="Collapsed" />

            <StackPanel x:Name="EmptyPanel"
                        Spacing="4"
                        Visibility="Collapsed">
                <TextBlock Text="还没有收藏夹"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="去抖音网页版创建收藏夹后再回来"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <StackPanel x:Name="ErrorPanel"
                        Spacing="6"
                        Visibility="Collapsed">
                <TextBlock x:Name="ErrorText"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
                <HyperlinkButton Content="重试"
                                 Padding="0"
                                 Click="OnRetryClick" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
